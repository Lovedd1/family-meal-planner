/* 全局样式 — Pop Style 玫瑰盐粉主题 */

page {
  background: linear-gradient(180deg, #FDF8F8 0%, #F5EEF0 100%);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  font-size: 28rpx;
  color: #5D4A4A;
  min-height: 100vh;
}

/* ========== 通用卡片 ========== */
.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 30rpx;
  margin: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(93, 74, 74, 0.08);
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
  color: #5D4A4A;
}

/* ========== 按钮 ========== */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  border-radius: 32rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  transition: transform 0.2s;
}

.btn:active {
  transform: scale(0.97);
}

.btn-primary {
  background: #C48B8B;
  color: #fff;
  box-shadow: 0 6rpx 20rpx rgba(196, 139, 139, 0.4);
}

.btn-default {
  background: #FDF8F8;
  color: #5D4A4A;
  border: 2rpx solid #E8D5D8;
}

.btn-danger {
  background: #C45C5C;
  color: #fff;
}

.btn-disabled {
  background: #e5e5e5;
  color: #999;
}

/* ========== 标签 ========== */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 16rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
  font-weight: 700;
}

.tag-danger {
  background: rgba(196, 92, 92, 0.12);
  color: #C45C5C;
}

.tag-warning {
  background: rgba(212, 168, 40, 0.12);
  color: #D4A828;
}

.tag-success {
  background: rgba(90, 138, 106, 0.12);
  color: #5A8A6A;
}

.tag-info {
  background: rgba(122, 138, 160, 0.12);
  color: #7A8AA0;
}

/* 加热标签 */
.tag-microwave-safe {
  background: rgba(90, 138, 106, 0.12);
  color: #5A8A6A;
}

.tag-microwave-none {
  background: rgba(196, 92, 92, 0.12);
  color: #C45C5C;
}

.tag-steam-only {
  background: rgba(212, 168, 40, 0.12);
  color: #D4A828;
}

.tag-fire-only {
  background: rgba(122, 138, 160, 0.12);
  color: #7A8AA0;
}

/* ========== 空状态 ========== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
  color: #BDBDBD;
}

.empty-state .icon {
  font-size: 100rpx;
  margin-bottom: 20rpx;
}

.empty-state .text {
  font-size: 28rpx;
  color: #8A6A6A;
}

.empty-state .text-small {
  font-size: 24rpx;
  color: #BDBDBD;
  margin-top: 8rpx;
}

/* ========== Toast ========== */
.toast {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background: rgba(93, 74, 74, 0.85);
  color: #fff;
  padding: 20rpx 40rpx;
  border-radius: 16rpx;
  z-index: 9999;
}

/* ========== Flex工具 ========== */
.flex { display: flex; }
.flex-center { display: flex; align-items: center; justify-content: center; }
.flex-between { display: flex; align-items: center; justify-content: space-between; }
.flex-col { display: flex; flex-direction: column; }
.flex-1 { flex: 1; }

/* ========== 间距 ========== */
.mt-10 { margin-top: 10rpx; }
.mt-20 { margin-top: 20rpx; }
.mt-30 { margin-top: 30rpx; }
.mb-10 { margin-bottom: 10rpx; }
.mb-20 { margin-bottom: 20rpx; }
.mb-30 { margin-bottom: 30rpx; }
.ml-10 { margin-left: 10rpx; }
.ml-20 { margin-left: 20rpx; }
.mr-10 { margin-right: 10rpx; }
.mr-20 { margin-right: 20rpx; }
.p-20 { padding: 20rpx; }
.p-30 { padding: 30rpx; }

/* ========== 文本 ========== */
.text-center { text-align: center; }
.text-right { text-align: right; }
.text-danger { color: #C45C5C; }
.text-warning { color: #D4A828; }
.text-success { color: #5A8A6A; }
.text-muted { color: #8A6A6A; }
.text-small { font-size: 24rpx; }
.text-large { font-size: 36rpx; }
.text-bold { font-weight: 600; }

/* ========== 装饰工具类 ========== */
.dashed-divider {
  border-bottom: 2rpx dashed #E8D5D8;
}

.gradient-stripe::after {
  content: '';
  display: block;
  height: 6rpx;
  background: repeating-linear-gradient(
    90deg,
    #C48B8B 0rpx,
    #C48B8B 8rpx,
    #E8D5D8 8rpx,
    #E8D5D8 16rpx
  );
}
