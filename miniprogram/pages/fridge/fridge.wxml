<!-- 我的冰箱页面 -->
<view class="page">
  <!-- 顶部导航 -->
  <view class="nav-bar">
    <view class="nav-title">我的冰箱</view>
    <view class="sync-status" wx:if="{{partnerNickname}}">
      <view class="status-dot"></view>
      <text>与{{partnerNickname}}同步中</text>
    </view>
  </view>

  <!-- 分类统计卡片 -->
  <view class="category-cards">
    <view
      class="category-card"
      wx:for="{{categories}}"
      wx:key="value"
      data-category="{{item.value}}"
      bindtap="switchFilter"
    >
      <text class="category-emoji">{{item.value === 'all' ? '📦' : item.value === 'meat' ? '🥩' : item.value === 'vegetable' ? '🥬' : item.value === 'fruit' ? '🍎' : '🧂'}}</text>
      <text class="category-name">{{item.label}}</text>
      <text class="category-count">{{item.count}}种</text>
    </view>
  </view>

  <!-- 操作栏 -->
  <view class="action-bar">
    <view class="action-buttons">
      <view class="action-btn" bindtap="showRecommendations">
        <text>🤖</text>
        <text>智能搭配</text>
      </view>
      <view class="action-btn primary" bindtap="showAddModal">
        <text>+</text>
        <text>添加食材</text>
      </view>
    </view>
  </view>

  <!-- 食材列表 -->
  <view class="item-list">
    <block wx:if="{{items.length > 0}}">
      <!-- 按到期日期分组显示 -->
      <view class="group-section" wx:for="{{groupedItems}}" wx:key="label">
        <view class="group-header {{item.class}}">
          <text class="group-label">{{item.label}}</text>
          <text class="group-count">{{item.items.length}}项</text>
        </view>
        <view
          class="item-card {{getDaysLeftClass(subItem.daysLeft)}}"
          wx:for="{{item.items}}"
          wx:for-item="subItem"
          wx:key="id"
          wx:if="{{filterCategory === 'all' || subItem.category === filterCategory}}"
        >
          <view class="item-left">
            <text class="item-category-tag">{{subItem.category === 'meat' ? '🥩' : subItem.category === 'vegetable' ? '🥬' : subItem.category === 'fruit' ? '🍎' : '🧂'}}</text>
            <view class="item-info">
              <text class="item-name">{{subItem.name}}</text>
              <view class="item-meta">
                <text>{{subItem.amount}}</text>
                <text class="days-left {{getDaysLeftClass(subItem.daysLeft)}}">
                  {{subItem.daysLeft <= 0 ? '今日到期' : '剩余' + subItem.daysLeft + '天'}}
                </text>
              </view>
            </view>
          </view>
          <view
            class="item-delete"
            data-id="{{subItem.id}}"
            bindtap="deleteItem"
          >删除</view>
        </view>
      </view>
    </block>
    <view class="empty-state" wx:else>
      <text class="icon">🧊</text>
      <text class="text">冰箱是空的</text>
      <text class="text-small">点击添加食材开始管理</text>
    </view>
  </view>

  <!-- 添加食材弹窗 -->
  <view class="modal" wx:if="{{showAddModal}}" bindtap="closeAddModal">
    <view class="modal-content" catchtap="">
      <view class="modal-header">
        <text class="modal-title">添加食材</text>
        <text class="modal-close" bindtap="closeAddModal">×</text>
      </view>
      <form bindsubmit="addItem" catchtap="preventBubble">
        <view class="form-body">
          <view class="form-item">
            <label>食材名称</label>
            <input name="name" placeholder="如：鸡蛋、西红柿" />
          </view>
          <view class="form-item">
            <label>分类</label>
            <radio-group name="category">
              <label><radio value="meat" /> 🥩 肉类</label>
              <label><radio value="vegetable" /> 🥬 蔬菜类</label>
              <label><radio value="fruit" /> 🍎 水果类</label>
              <label><radio value="seasoning" /> 🧂 调料类</label>
            </radio-group>
          </view>
          <view class="form-item">
            <label>剩余天数</label>
            <input name="daysLeft" type="number" value="7" placeholder="预计保质期" />
          </view>
          <view class="form-item">
            <label>数量</label>
            <input name="amount" placeholder="如：500g、3个" />
          </view>
        </view>
        <view class="modal-footer">
          <button type="default" catchtap="closeAddModal">取消</button>
          <button type="primary" form-type="submit">保存</button>
        </view>
      </form>
    </view>
  </view>

  <!-- 智能推荐弹窗 -->
  <view class="modal" wx:if="{{showRecommendModal}}" bindtap="closeRecommendModal">
    <view class="modal-content recommend-modal" catchtap="">
      <view class="modal-header">
        <text class="modal-title">智能搭配推荐</text>
        <text class="modal-close" bindtap="closeRecommendModal">×</text>
      </view>
      <view class="modal-body">
        <view class="recommend-tip">
          🤖 基于最快过期食材优先匹配 · 匹配度≥50%
        </view>
        <view class="recommend-list">
          <view
            class="recommend-item"
            wx:for="{{recommendations}}"
            wx:key="id"
          >
            <text class="recommend-emoji">{{item.emoji}}</text>
            <view class="recommend-info">
              <view class="recommend-header">
                <text class="recommend-name">{{item.name}}</text>
                <text class="recommend-ratio {{item.matchRatio >= 80 ? 'high' : item.matchRatio >= 60 ? 'mid' : 'low'}}">{{item.matchRatio}}%</text>
              </view>
              <view class="recommend-tags">
                <text class="match-tag success">✓ {{item.matchedCount}}项可配</text>
                <text class="match-tag danger" wx:if="{{item.missingIngredients}}">✗ {{item.missingIngredients}}</text>
              </view>
              <text class="recommend-category">{{item.category}}</text>
            </view>
            <button
              class="btn-mini"
              data-food="{{item}}"
              bindtap="addToDinner"
            >+ 晚餐</button>
          </view>
          <view class="empty-recommend" wx:if="{{recommendations.length === 0}}">
            <text>🧊 添加更多食材后查看推荐</text>
            <text class="empty-hint">至少需要50%食材匹配才能推荐</text>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
