/* 我的冰箱 — Pop Style */
.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #FDF8F8 0%, #F5EEF0 100%);
  padding-bottom: 60rpx;
}

/* ========== 导航栏 ========== */
.nav-bar {
  background: linear-gradient(135deg, #E8D5D8 0%, #C48B8B 100%);
  padding: 60rpx 30rpx 30rpx;
  position: relative;
}

.nav-bar::after {
  content: '';
  position: absolute;
  bottom: -20rpx;
  left: 0;
  right: 0;
  height: 40rpx;
  background: #F5EEF0;
  border-radius: 20rpx 20rpx 0 0;
}

.nav-title {
  font-size: 44rpx;
  font-weight: 600;
  color: #5D4A4A;
  letter-spacing: 2rpx;
}

.sync-status {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgba(93, 74, 74, 0.8);
}

.status-dot {
  width: 14rpx;
  height: 14rpx;
  background: #5A8A6A;
  border-radius: 50%;
}

/* ========== 分类卡片 ========== */
.category-cards {
  display: flex;
  gap: 16rpx;
  margin: -30rpx 24rpx 24rpx;
  position: relative;
  z-index: 10;
  overflow-x: auto;
  padding: 10rpx 0;
  -webkit-overflow-scrolling: touch;
}

.category-cards::-webkit-scrollbar {
  display: none;
}

.category-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 130rpx;
  height: 140rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(93, 74, 74, 0.08);
  padding: 16rpx;
  flex-shrink: 0;
  position: relative;
  overflow: hidden;
}

.category-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 5rpx;
  background: repeating-linear-gradient(
    90deg,
    #C48B8B 0rpx,
    #C48B8B 6rpx,
    #E8D5D8 6rpx,
    #E8D5D8 12rpx
  );
}

.category-card::after {
  content: '';
  position: absolute;
  top: 16rpx;
  right: 10rpx;
  width: 12rpx;
  height: 12rpx;
  background: #E8D5D8;
  border-radius: 50%;
  opacity: 0.6;
}

.category-emoji {
  font-size: 44rpx;
  margin-bottom: 6rpx;
}

.category-name {
  font-family: monospace;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: #8A6A6A;
  text-transform: uppercase;
}

.category-count {
  font-family: monospace;
  font-size: 32rpx;
  font-weight: 700;
  color: #C48B8B;
}

/* ========== 操作栏 ========== */
.action-bar {
  background: #fff;
  padding: 20rpx 24rpx;
  margin: 0 24rpx 20rpx;
  border-radius: 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(93, 74, 74, 0.06);
}

.filter-tabs {
  display: flex;
  gap: 10rpx;
}

.filter-tab {
  padding: 10rpx 24rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
  font-weight: 600;
  background: #FDF8F8;
  color: #8A6A6A;
  transition: all 0.2s;
}

.filter-tab.active {
  background: #C48B8B;
  color: #fff;
}

.action-buttons {
  display: flex;
  gap: 10rpx;
}

.action-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 12rpx 22rpx;
  border-radius: 24rpx;
  background: #FDF8F8;
  font-size: 24rpx;
  color: #8A6A6A;
}

.action-btn.primary {
  background: #C48B8B;
  color: #fff;
}

/* ========== 食材列表 ========== */
.item-list {
  padding: 0 24rpx;
}

.group-section {
  margin-bottom: 20rpx;
}

.group-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 20rpx;
  margin-bottom: 14rpx;
  border-radius: 16rpx;
  background: #fff;
  position: relative;
  overflow: hidden;
}

.group-header::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  width: 6rpx;
  height: 100%;
}

.group-header.expire-today::before { background: #C45C5C; }
.group-header.expire-tomorrow::before { background: #D4A828; }
.group-header.expire-week::before { background: #5A8A6A; }
.group-header.expire-later::before { background: #E8D5D8; }

.group-label {
  font-family: monospace;
  font-size: 26rpx;
  font-weight: 700;
  color: #5D4A4A;
  letter-spacing: 2rpx;
}

.group-count {
  font-family: monospace;
  font-size: 22rpx;
  color: #8A6A6A;
}

.item-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 24rpx;
  padding: 26rpx;
  margin-bottom: 14rpx;
  position: relative;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(93, 74, 74, 0.06);
}

.item-card::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  width: 6rpx;
  height: 100%;
}

.item-card::before {
  background: repeating-linear-gradient(
    180deg,
    #5A8A6A 0rpx,
    #5A8A6A 8rpx,
    transparent 8rpx,
    transparent 16rpx
  );
}

.item-card.warning::before {
  background: repeating-linear-gradient(
    180deg,
    #D4A828 0rpx,
    #D4A828 8rpx,
    transparent 8rpx,
    transparent 16rpx
  );
}

.item-card.danger::before {
  background: repeating-linear-gradient(
    180deg,
    #C45C5C 0rpx,
    #C45C5C 8rpx,
    transparent 8rpx,
    transparent 16rpx
  );
}

.item-left {
  flex: 1;
  display: flex;
  align-items: center;
}

.item-category-tag {
  font-size: 44rpx;
  margin-right: 18rpx;
  position: relative;
}

.item-info {
  flex: 1;
}

.item-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #5D4A4A;
  margin-bottom: 6rpx;
}

.item-meta {
  display: flex;
  gap: 16rpx;
  font-size: 24rpx;
  color: #8A6A6A;
}

.days-left {
  font-weight: 700;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
}

.days-left.danger {
  background: rgba(196, 92, 92, 0.12);
  color: #C45C5C;
}

.days-left.warning {
  background: rgba(212, 168, 40, 0.12);
  color: #D4A828;
}

.days-left:not(.danger):not(.warning) {
  background: rgba(90, 138, 106, 0.12);
  color: #5A8A6A;
}

.item-delete {
  color: #C45C5C;
  font-size: 26rpx;
  padding: 12rpx 20rpx;
  background: #FFF5F5;
  border-radius: 32rpx;
}

/* ========== 弹窗 ========== */
.modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(93, 74, 74, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  background: #fff;
  border-radius: 32rpx;
  width: 90%;
  max-height: 80vh;
  overflow: hidden;
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx;
  border-bottom: 2rpx dashed #E8D5D8;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #5D4A4A;
}

.modal-close {
  font-size: 48rpx;
  color: #BDBDBD;
  line-height: 1;
}

.form-body {
  padding: 30rpx;
}

.form-item {
  margin-bottom: 30rpx;
}

.form-item label {
  display: block;
  font-size: 26rpx;
  color: #8A6A6A;
  margin-bottom: 14rpx;
  font-weight: 600;
}

.form-item input {
  width: 100%;
  height: 80rpx;
  border: 2rpx solid #E8D5D8;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  background: #FDF8F8;
  color: #5D4A4A;
}

.form-item radio-group {
  display: flex;
  gap: 20rpx;
}

.form-item radio-group label {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-weight: 400;
}

.modal-footer {
  display: flex;
  gap: 20rpx;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  border-top: 2rpx dashed #E8D5D8;
}

.modal-footer button {
  flex: 1;
}

/* 推荐弹窗 */
.recommend-modal .modal-content {
  max-height: 85vh;
}

.recommend-tip {
  text-align: center;
  color: #8A6A6A;
  font-size: 24rpx;
  margin-bottom: 20rpx;
  padding: 14rpx;
  background: #FDF8F8;
  border-radius: 12rpx;
}

.recommend-list {
  max-height: 60vh;
  overflow-y: auto;
}

.recommend-item {
  display: flex;
  align-items: flex-start;
  padding: 22rpx;
  border-bottom: 2rpx dashed #E8D5D8;
  position: relative;
}

.recommend-item:last-child {
  border-bottom: none;
}

.recommend-emoji {
  font-size: 48rpx;
  margin-right: 18rpx;
  line-height: 1;
}

.recommend-info {
  flex: 1;
}

.recommend-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.recommend-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #5D4A4A;
}

.recommend-ratio {
  font-family: monospace;
  font-size: 24rpx;
  font-weight: 700;
  padding: 4rpx 12rpx;
  border-radius: 10rpx;
}

.recommend-ratio.high {
  background: rgba(90, 138, 106, 0.15);
  color: #5A8A6A;
}

.recommend-ratio.mid {
  background: rgba(212, 168, 40, 0.15);
  color: #D4A828;
}

.recommend-ratio.low {
  background: rgba(196, 139, 139, 0.15);
  color: #C48B8B;
}

.recommend-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 8rpx;
}

.match-tag {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.match-tag.success {
  background: rgba(90, 138, 106, 0.12);
  color: #5A8A6A;
}

.match-tag.danger {
  background: rgba(196, 92, 92, 0.12);
  color: #C45C5C;
}

.recommend-category {
  font-size: 22rpx;
  color: #8A6A6A;
  font-family: monospace;
}

.btn-mini {
  font-size: 24rpx;
  padding: 12rpx 22rpx;
  background: #C48B8B;
  color: #fff;
  border-radius: 24rpx;
  line-height: 1.6;
  box-shadow: 0 4rpx 12rpx rgba(196, 139, 139, 0.3);
  margin-left: 12rpx;
}

.empty-recommend {
  text-align: center;
  padding: 60rpx 30rpx;
  color: #8A6A6A;
}

.empty-recommend .empty-hint {
  display: block;
  font-size: 24rpx;
  color: #BDBDBD;
  margin-top: 12rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.empty-state .icon {
  font-size: 100rpx;
}

.empty-state .text {
  font-size: 28rpx;
  color: #8A6A6A;
  margin-top: 20rpx;
}

.empty-state .text-small {
  font-size: 24rpx;
  color: #BDBDBD;
}
