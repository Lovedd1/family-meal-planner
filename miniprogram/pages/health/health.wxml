<!-- 健康计划页面 -->
<view class="page">
  <!-- 顶部导航 -->
  <view class="nav-bar">
    <view class="nav-title">健康计划</view>
  </view>

  <scroll-view class="content" scroll-y>
    <!-- 伴侣健康档案 -->
    <view class="card partner-card" wx:if="{{partnerProfile}}">
      <view class="card-header">
        <text class="card-title">👤 {{partnerProfile.nickname}} 的档案</text>
      </view>
      <view class="partner-info">
        <view class="info-item">
          <text>体重</text>
          <text>{{partnerProfile.weight}}kg</text>
        </view>
        <view class="info-item">
          <text>目标</text>
          <text>{{partnerProfile.targetWeight}}kg</text>
        </view>
        <view class="info-item">
          <text>差距</text>
          <text class="text-danger">{{partnerProfile.weight - partnerProfile.targetWeight}}kg</text>
        </view>
      </view>
    </view>

    <!-- 我的健康档案 -->
    <view class="card">
      <view class="card-header">
        <text class="card-title">📋 我的健康档案</text>
        <text class="edit-btn" bindtap="showEditProfile">编辑</text>
      </view>

      <!-- 饮食目标 -->
      <view class="goal-selector">
        <view
          class="goal-btn {{dietGoal === 'lose' ? 'active' : ''}}"
          data-goal="lose"
          bindtap="setDietGoal"
        >
          📉 减肥
        </view>
        <view
          class="goal-btn {{dietGoal === 'maintain' ? 'active' : ''}}"
          data-goal="maintain"
          bindtap="setDietGoal"
        >
          ⚖️ 维持
        </view>
        <view
          class="goal-btn {{dietGoal === 'gain' ? 'active' : ''}}"
          data-goal="gain"
          bindtap="setDietGoal"
        >
          📈 增重
        </view>
      </view>

      <!-- 数据概览 -->
      <view class="data-overview">
        <view class="data-item">
          <text class="data-label">当前体重</text>
          <text class="data-value">{{currentWeight || '--'}}</text>
          <text class="data-unit">kg</text>
        </view>
        <view class="data-item">
          <text class="data-label">目标体重</text>
          <text class="data-value text-success">{{targetWeight || '--'}}</text>
          <text class="data-unit">kg</text>
        </view>
        <view class="data-item">
          <text class="data-label">身高</text>
          <text class="data-value">{{height || '--'}}</text>
          <text class="data-unit">cm</text>
        </view>
      </view>

      <!-- 活动量 -->
      <view class="activity-selector">
        <text class="section-label">日常活动量</text>
        <view class="activity-btns">
          <view
            class="activity-btn {{activityLevel === 'sedentary' ? 'active' : ''}}"
            data-level="sedentary"
            bindtap="setActivityLevel"
          >久坐少动</view>
          <view
            class="activity-btn {{activityLevel === 'moderate' ? 'active' : ''}}"
            data-level="moderate"
            bindtap="setActivityLevel"
          >适度活动</view>
          <view
            class="activity-btn {{activityLevel === 'active' ? 'active' : ''}}"
            data-level="active"
            bindtap="setActivityLevel"
          >运动较多</view>
        </view>
      </view>

      <!-- 过敏源 -->
      <view class="allergy-section" wx:if="{{allergies}}">
        <text class="section-label">食物过敏源</text>
        <view class="allergy-tags">
          <text class="allergy-tag" wx:for="{{allergyList}}" wx:key="*this">
            {{item}}
          </text>
        </view>
      </view>

      <button class="btn btn-primary btn-record" bindtap="recordWeight">
        记录今日体重
      </button>
    </view>

    <!-- 体重趋势折线图 -->
    <view class="card" wx:if="{{weightRecords.length > 0}}">
      <view class="card-header">
        <text class="card-title">📊 30天体重趋势</text>
      </view>
      <view class="chart-container">
        <!-- 进度条 -->
        <view class="progress-bar">
          <view class="progress-inner" style="width: {{weightStats.progress}}%"></view>
        </view>
        <view class="progress-label">
          <text>当前 {{weightStats.current}}kg</text>
          <text class="text-success">{{weightStats.diff > 0 ? '距目标还有' : '已达标'}}{{weightStats.absDiff}}kg</text>
          <text>目标 {{weightStats.target}}kg</text>
        </view>
      </view>
    </view>

    <!-- 饮食分析卡片 -->
    <view class="diet-analysis-card" wx:if="{{dietHistory.length >= 3}}">
      <view class="card-header">
        <text class="card-title">📊 饮食分析</text>
        <text class="analyzing-tip" wx:if="{{isAnalyzing}}">分析中...</text>
      </view>

      <!-- 分析摘要 -->
      <view class="analysis-summary" wx:if="{{aiAnalysis}}">
        {{aiAnalysis.analysis.summary}}
      </view>

      <!-- 需要补充 -->
      <view class="needs-section" wx:if="{{aiAnalysis && aiAnalysis.analysis.needsMore.length > 0}}">
        <view class="section-title">需要补充</view>
        <view class="need-item" wx:for="{{aiAnalysis.analysis.needsMore}}" wx:key="type">
          <view class="need-type">{{item.type === 'protein' ? '🥩 蛋白质' : item.type === 'fiber' ? '🥬 膳食纤维' : item.type === 'carbs' ? '🥖 碳水' : '🥑 脂肪'}}</view>
          <view class="need-reason">{{item.reason}}</view>
          <view class="need-suggestions">
            <view class="suggestion-tag" wx:for="{{item.suggestions}}" wx:key="id" data-dish="{{item}}" data-meal="breakfast" bindtap="addRecommendedDish">
              {{item.emoji}} {{item.name}}
            </view>
          </view>
        </view>
      </view>

      <!-- 需要减少 -->
      <view class="needs-section" wx:if="{{aiAnalysis && aiAnalysis.analysis.needsLess.length > 0}}">
        <view class="section-title needs-less">需要减少</view>
        <view class="need-item" wx:for="{{aiAnalysis.analysis.needsLess}}" wx:key="type">
          <view class="need-type">{{item.type === 'carbs' ? '🥖 碳水' : item.type === 'fat' ? '🥑 脂肪' : item.type}}</view>
          <view class="need-reason">{{item.reason}}（当前{{item.currentAvg}}，建议{{item.suggested}}）</view>
        </view>
      </view>

      <!-- 明日推荐 -->
      <view class="tomorrow-menu" wx:if="{{aiAnalysis && aiAnalysis.tomorrowMenu}}">
        <view class="section-title">明日推荐</view>
        <view class="meal-section">
          <view class="meal-label">🌅 早餐</view>
          <view class="meal-dishes">
            <view class="dish-chip" wx:for="{{aiAnalysis.tomorrowMenu.breakfast}}" wx:key="id" data-dish="{{item}}" data-meal="breakfast" bindtap="addRecommendedDish">
              {{item.emoji}} {{item.name}}
            </view>
          </view>
        </view>
        <view class="meal-section">
          <view class="meal-label">☀️ 午餐</view>
          <view class="meal-dishes">
            <view class="dish-chip" wx:for="{{aiAnalysis.tomorrowMenu.lunch}}" wx:key="id" data-dish="{{item}}" data-meal="lunch" bindtap="addRecommendedDish">
              {{item.emoji}} {{item.name}}
            </view>
          </view>
        </view>
        <view class="meal-section">
          <view class="meal-label">🌙 晚餐</view>
          <view class="meal-dishes">
            <view class="dish-chip" wx:for="{{aiAnalysis.tomorrowMenu.dinner}}" wx:key="id" data-dish="{{item}}" data-meal="dinner" bindtap="addRecommendedDish">
              {{item.emoji}} {{item.name}}
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 数据不足提示 -->
    <view class="diet-analysis-locked" wx:elif="{{dietHistory.length > 0 && dietHistory.length < 3}}">
      <text>📝 再记录{{3 - dietHistory.length}}天即可解锁AI饮食分析</text>
    </view>

    <!-- 生理期追踪 -->
    <view class="card">
      <view class="card-header">
        <text class="card-title">🌸 生理期追踪</text>
        <text class="edit-btn" bindtap="openMenstrualSettings">设置</text>
      </view>

      <block wx:if="{{menstrualSettings.lastPeriodDate}}">
        <view class="phase-status">
          <view class="phase-badge phase-{{currentPhase}}">
            {{getPhaseLabel(currentPhase)}}
          </view>
          <text class="phase-day">第{{phaseDay}}天 / {{menstrualSettings.cycleDays}}天周期</text>
        </view>

        <view class="calendar-view">
          <view class="calendar-legend">
            <view class="legend-item">
              <view class="legend-dot period"></view>
              <text>经期(1-{{menstrualSettings.periodDays}}天)</text>
            </view>
            <view class="legend-item">
              <view class="legend-dot fertile"></view>
              <text>易孕期</text>
            </view>
            <view class="legend-item">
              <view class="legend-dot today"></view>
              <text>今天</text>
            </view>
          </view>
          <view class="calendar-grid">
            <view
              class="day-cell {{getDayClass(index + 1, phaseDay, menstrualSettings.periodDays)}}"
              wx:for="{{menstrualSettings.cycleDays}}"
              wx:key="*this"
            >
              <text>{{index + 1}}</text>
            </view>
          </view>
        </view>

        <view class="phase-tips">
          <text class="phase-tip-title">{{getPhaseLabel(currentPhase)}}饮食建议</text>
          <text class="phase-tip-text">
            {{currentPhase === 'menstruation' ? '温热、补铁，推荐：红枣桂圆粥、红糖姜茶' :
              currentPhase === 'follicular' ? '高蛋白、富含叶酸，推荐：三文鱼、鸡蛋、牛奶' :
              currentPhase === 'ovulation' ? '补气血，推荐：红枣乌鸡汤、坚果、牛肉' :
              '清淡少盐、膳食纤维，推荐：杂粮饭、绿叶蔬菜'}}
          </text>
        </view>
      </block>
      <view class="empty-phase" wx:else bindtap="showMenstrualSettings">
        <text>点击设置月经日期</text>
      </view>
    </view>

    <!-- 历史饮食列表 -->
    <view class="diet-history-section" wx:if="{{dietHistory.length > 0}}">
      <view class="section-header" bindtap="toggleDietHistory">
        <text>近7天饮食记录</text>
        <text class="toggle-icon">{{showDietHistory ? '▼' : '▶'}}</text>
      </view>
      <view class="history-list" wx:if="{{showDietHistory}}">
        <view class="history-item" wx:for="{{dietHistory}}" wx:key="date">
          <view class="history-date">{{item.date}}</view>
          <view class="history-dishes">
            <text wx:for="{{item.menu.breakfast}}" wx:key="id">{{item.emoji}}</text>
            <text wx:for="{{item.menu.lunch}}" wx:key="id">{{item.emoji}}</text>
            <text wx:for="{{item.menu.dinner}}" wx:key="id">{{item.emoji}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 健康报告列表 -->
    <view class="card" wx:if="{{healthReports.length > 0}}">
      <view class="card-header">
        <text class="card-title">📋 健康报告</text>
      </view>
      <view class="report-list">
        <view
          class="report-card"
          wx:for="{{healthReports}}"
          wx:key="id"
          data-report="{{item}}"
          bindtap="showReport"
        >
          <view class="report-header">
            <view class="report-title">{{item.title}}</view>
            <view class="report-date">{{item.date}}</view>
          </view>
          <view class="report-summary">{{item.summary}}</view>
          <view class="report-tags">
            <text
              class="report-tag {{getReportTagClass(tag)}}"
              wx:for="{{item.tags}}"
              wx:key="*this"
            >{{tag}}</text>
          </view>
          <view class="report-meta">
            <view class="report-score">综合评分 {{item.score}}</view>
            <view class="report-view">查看详情 ›</view>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>

  <!-- 编辑档案弹窗 -->
  <view class="modal" wx:if="{{showEditProfile}}">
    <view class="modal-content" catchtap="">
      <view class="modal-header">
        <text class="modal-title">编辑健康档案</text>
        <text class="modal-close" bindtap="closeEditProfile">×</text>
      </view>
      <form bindsubmit="saveProfile" catchtap="preventBubble">
        <view class="form-body">
          <view class="form-item">
            <label>当前体重(kg)</label>
            <input name="currentWeight" type="digit" value="{{currentWeight}}" />
          </view>
          <view class="form-item">
            <label>目标体重(kg)</label>
            <input name="targetWeight" type="digit" value="{{targetWeight}}" />
          </view>
          <view class="form-item">
            <label>身高(cm)</label>
            <input name="height" type="number" value="{{height}}" />
          </view>
          <view class="form-item">
            <label>食物过敏源(逗号分隔)</label>
            <input name="allergies" value="{{allergies}}" placeholder="如：虾、芒果" />
          </view>
        </view>
        <view class="modal-footer">
          <button type="default" catchtap="closeEditProfile">取消</button>
          <button type="primary" form-type="submit">保存</button>
        </view>
      </form>
    </view>
  </view>

  <!-- 饮食计划弹窗 -->
  <view class="modal" wx:if="{{showDietPlan}}">
    <view class="modal-content diet-plan-modal" catchtap="">
      <view class="modal-header">
        <text class="modal-title">AI 饮食计划</text>
        <text class="modal-close" bindtap="closeDietPlan">×</text>
      </view>

      <!-- 阶段Tab -->
      <view class="plan-tabs">
        <view
          class="plan-tab {{currentPlanPhase === index ? 'active' : ''}}"
          wx:for="{{dietPlan.phases}}"
          wx:key="name"
          data-index="{{index}}"
          bindtap="switchPlanPhase"
        >
          {{item.name}}
        </view>
      </view>

      <scroll-view class="modal-body" scroll-y>
        <block wx:if="{{dietPlan.phases[currentPlanPhase]}}">
          <view class="phase-info">
            <view class="phase-info-item">
              <text class="info-label">周期</text>
              <text class="info-value">{{dietPlan.phases[currentPlanPhase].duration}}</text>
            </view>
            <view class="phase-info-item">
              <text class="info-label">热量</text>
              <text class="info-value">{{dietPlan.phases[currentPlanPhase].calories}}</text>
            </view>
          </view>
          <view class="phase-focus-text">{{dietPlan.phases[currentPlanPhase].focus}}</view>

          <!-- 周计划 -->
          <view class="weekly-plans" wx:for="{{dietPlan.phases[currentPlanPhase].weeklyMenus}}" wx:key="week">
            <view class="week-title">第{{item.week}}周</view>
            <view class="day-plans" wx:for="{{item.days}}" wx:key="index">
              <view class="day-plan-header">周{{index + 1}}</view>

              <view class="meal-item">
                <text class="meal-label">🌅 早餐</text>
                <view class="meal-content">
                  <text class="meal-name">{{item.breakfast.name}}</text>
                  <text class="meal-effect">{{item.breakfast.effect}}</text>
                  <view class="meal-ingredients">
                    <text class="ing-label">食材：</text>
                    <text class="ing-list">{{item.breakfast._ingredientsStr}}</text>
                  </view>
                </view>
              </view>

              <view class="meal-item">
                <text class="meal-label">☀️ 午餐</text>
                <view class="meal-content">
                  <text class="meal-name">{{item.lunch.name}}</text>
                  <text class="meal-effect">{{item.lunch.effect}}</text>
                  <view class="meal-ingredients">
                    <text class="ing-label">食材：</text>
                    <text class="ing-list">{{item.lunch._ingredientsStr}}</text>
                  </view>
                </view>
              </view>

              <view class="meal-item">
                <text class="meal-label">🌙 晚餐</text>
                <view class="meal-content">
                  <text class="meal-name">{{item.dinner.name}}</text>
                  <text class="meal-effect">{{item.dinner.effect}}</text>
                  <view class="meal-ingredients">
                    <text class="ing-label">食材：</text>
                    <text class="ing-list">{{item.dinner._ingredientsStr}}</text>
                  </view>
                </view>
              </view>

              <view class="meal-item snacks" wx:if="{{item.snacks.length > 0}}">
                <text class="meal-label">🍪 加餐</text>
                <view class="meal-content">
                  <view class="snack-list">
                    <text wx:for="{{item.snacks}}" wx:key="name">{{item.time}}: {{item.name}}</text>
                  </view>
                </view>
              </view>
            </view>
          </view>

          <!-- 采购清单 -->
          <view class="shopping-section">
            <view class="shopping-title">📋 采购清单（2天量）</view>
            <view class="shopping-list">
              <view
                class="shopping-item {{item.inStock ? 'sufficient' : 'need-buy'}}"
                wx:for="{{dietPlan.phases[currentPlanPhase].shoppingList}}"
                wx:key="name"
              >
                <text class="shopping-icon">{{item.inStock ? '✅' : '⚠️'}}</text>
                <text class="shopping-name">{{item.name}}</text>
                <text class="shopping-amount">{{item.amount}}</text>
                <text class="shopping-period">{{item.period}}</text>
              </view>
            </view>
          </view>
        </block>
      </scroll-view>
    </view>
  </view>

  <!-- 平台期提醒 -->
  <view class="modal" wx:if="{{showPlateauAlert}}">
    <view class="modal-content">
      <view class="modal-header">
        <text class="modal-title">⚠️ 体重平台期提醒</text>
      </view>
      <view class="modal-body">
        <text>连续3次体重变化小于0.3kg，可能进入平台期。</text>
        <text class="plateau-tip">是否需要调整热量目标？</text>
      </view>
      <view class="modal-footer">
        <button bindtap="setData({showPlateauAlert: false})">暂不调整</button>
        <button type="primary" bindtap="setData({showPlateauAlert: false})">调整计划</button>
      </view>
    </view>
  </view>

  <!-- 健康报告详情弹窗 -->
  <view class="modal" wx:if="{{showReportModal}}">
    <view class="modal-content" catchtap="">
      <view class="modal-header">
        <text class="modal-title">{{currentReport.title}}</text>
        <text class="modal-close" bindtap="closeReportModal">×</text>
      </view>
      <view class="modal-body">
        <view class="report-detail-date">{{currentReport.date}}</view>
        <view class="report-detail-summary">{{currentReport.summary}}</view>
        <view class="report-detail-tags">
          <text
            class="report-tag {{getReportTagClass(tag)}}"
            wx:for="{{currentReport.tags}}"
            wx:key="*this"
          >{{tag}}</text>
        </view>
        <view class="report-detail-score">
          <text>综合评分</text>
          <text class="score-num">{{currentReport.score}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 生理期设置弹窗 -->
  <view class="modal" wx:if="{{showMenstrualSettings}}">
    <view class="modal-content" catchtap="">
      <view class="modal-header">
        <text class="modal-title">🌸 生理期设置</text>
        <text class="modal-close" bindtap="closeMenstrualSettings">×</text>
      </view>
      <view class="modal-body menstrual-settings-body">
        <view class="settings-tip">设置后日历将自动计算经期和易孕期</view>

        <view class="form-item">
          <label>上次月经开始日期</label>
          <picker mode="date" value="{{tempMenstrual.lastPeriodDate}}" bindchange="bindPeriodDateChange">
            <view class="picker-value {{tempMenstrual.lastPeriodDate ? '' : 'placeholder'}}">
              {{tempMenstrual.lastPeriodDate || '请选择日期'}}
            </view>
          </picker>
        </view>

        <view class="form-item">
          <label>月经周期（天）</label>
          <view class="stepper-input">
            <view class="stepper-btn" bindtap="adjustCycleDays" data delta="-1">−</view>
            <input
              class="stepper-value"
              type="number"
              value="{{tempMenstrual.cycleDays}}"
              bindinput="inputCycleDays"
            />
            <view class="stepper-btn" bindtap="adjustCycleDays" data-delta="1">+</view>
          </view>
          <text class="form-hint">两次月经第一天的间隔天数，默认28天</text>
        </view>

        <view class="form-item">
          <label>经期时长（天）</label>
          <view class="stepper-input">
            <view class="stepper-btn" bindtap="adjustPeriodDays" data-delta="-1">−</view>
            <input
              class="stepper-value"
              type="number"
              value="{{tempMenstrual.periodDays}}"
              bindinput="inputPeriodDays"
            />
            <view class="stepper-btn" bindtap="adjustPeriodDays" data-delta="1">+</view>
          </view>
          <text class="form-hint">月经持续的天数，默认5天</text>
        </view>
      </view>
      <view class="modal-footer">
        <button type="default" catchtap="closeMenstrualSettings">取消</button>
        <button type="primary" bindtap="saveMenstrualSettings">保存</button>
      </view>
    </view>
  </view>
</view>
