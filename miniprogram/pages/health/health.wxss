/* 健康计划 — Pop Style */
.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #FDF8F8 0%, #F5EEF0 100%);
  padding-bottom: 30rpx;
}

/* ========== 导航栏 ========== */
.nav-bar {
  background: linear-gradient(135deg, #E8D5D8 0%, #C48B8B 100%);
  padding: 60rpx 30rpx 30rpx;
  position: relative;
}

.nav-bar::after {
  content: '';
  position: absolute;
  bottom: -20rpx;
  left: 0;
  right: 0;
  height: 40rpx;
  background: #F5EEF0;
  border-radius: 20rpx 20rpx 0 0;
}

.nav-title {
  font-size: 44rpx;
  font-weight: 600;
  color: #5D4A4A;
  letter-spacing: 2rpx;
}

.content {
  height: calc(100vh - 90rpx);
}

/* ========== 通用卡片 ========== */
.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 30rpx;
  margin: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(93, 74, 74, 0.06);
  position: relative;
  overflow: hidden;
}

.card::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 5rpx;
  background: repeating-linear-gradient(
    90deg,
    #C48B8B 0rpx,
    #C48B8B 6rpx,
    #E8D5D8 6rpx,
    #E8D5D8 12rpx
  );
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #5D4A4A;
}

.edit-btn {
  font-size: 26rpx;
  color: #C48B8B;
  font-weight: 600;
}

/* ========== 伴侣卡片 ========== */
.partner-card {
  border-left: 6rpx solid #C48B8B;
}

.partner-info {
  display: flex;
  gap: 20rpx;
}

.info-item {
  flex: 1;
  text-align: center;
}

.info-item text:first-child {
  display: block;
  font-size: 24rpx;
  color: #8A6A6A;
}

.info-item text:last-child {
  font-size: 30rpx;
  font-weight: 600;
  color: #5D4A4A;
}

/* ========== 目标选择 ========== */
.goal-selector {
  display: flex;
  gap: 16rpx;
  margin-bottom: 30rpx;
}

.goal-btn {
  flex: 1;
  padding: 22rpx;
  text-align: center;
  border-radius: 20rpx;
  background: #FDF8F8;
  font-size: 28rpx;
  color: #8A6A6A;
  font-weight: 600;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.goal-btn.active {
  background: #C48B8B;
  color: #fff;
  border-color: #C48B8B;
  box-shadow: 0 4rpx 16rpx rgba(196, 139, 139, 0.3);
}

/* ========== 数据概览 ========== */
.data-overview {
  display: flex;
  justify-content: space-around;
  padding: 24rpx 0;
  border-top: 2rpx dashed #E8D5D8;
  border-bottom: 2rpx dashed #E8D5D8;
  margin: 20rpx 0;
}

.data-item {
  text-align: center;
}

.data-label {
  display: block;
  font-size: 24rpx;
  color: #8A6A6A;
  margin-bottom: 8rpx;
}

.data-value {
  font-size: 44rpx;
  font-weight: 700;
  color: #5D4A4A;
}

.data-unit {
  font-size: 24rpx;
  color: #8A6A6A;
}

/* ========== 活动量 ========== */
.activity-selector {
  margin-bottom: 20rpx;
}

.section-label {
  font-size: 26rpx;
  color: #8A6A6A;
  margin-bottom: 14rpx;
  display: block;
  font-weight: 600;
}

.activity-btns {
  display: flex;
  gap: 12rpx;
}

.activity-btn {
  flex: 1;
  padding: 14rpx;
  text-align: center;
  border-radius: 16rpx;
  background: #FDF8F8;
  font-size: 24rpx;
  color: #8A6A6A;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.activity-btn.active {
  background: #C48B8B;
  color: #fff;
  border-color: #C48B8B;
}

/* ========== 过敏源 ========== */
.allergy-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.allergy-tag {
  padding: 8rpx 20rpx;
  background: rgba(196, 92, 92, 0.1);
  color: #C45C5C;
  border-radius: 24rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.btn-record {
  margin-top: 24rpx;
}

/* 旧柱状图样式保留（兼容） */
.weight-chart {
  padding: 20rpx 0;
}

.chart-bars {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  height: 140rpx;
  padding-bottom: 40rpx;
}

.chart-bar {
  flex: 1;
  background: linear-gradient(to top, #C48B8B, #E8D5D8);
  border-radius: 6rpx 6rpx 0 0;
  margin: 0 3rpx;
  min-height: 20rpx;
  position: relative;
}

.bar-value {
  position: absolute;
  bottom: -36rpx;
  left: 50%;
  transform: translateX(-50%);
  font-size: 18rpx;
  color: #8A6A6A;
  white-space: nowrap;
}

.progress-bar {
  height: 12rpx;
  background: #E8D5D8;
  border-radius: 6rpx;
  margin-top: 60rpx;
  overflow: hidden;
}

.progress-inner {
  height: 100%;
  background: linear-gradient(to right, #C48B8B, #A67070);
  border-radius: 6rpx;
  transition: width 0.3s;
}

.progress-label {
  display: flex;
  justify-content: space-between;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #8A6A6A;
}

/* ========== 生理期 ========== */
.phase-status {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.phase-badge {
  padding: 12rpx 28rpx;
  border-radius: 24rpx;
  font-size: 26rpx;
  font-weight: 600;
}

.phase-menstruation {
  background: rgba(196, 92, 92, 0.12);
  color: #C45C5C;
}

.phase-follicular {
  background: rgba(90, 138, 106, 0.12);
  color: #5A8A6A;
}

.phase-ovulation {
  background: rgba(212, 168, 40, 0.12);
  color: #D4A828;
}

.phase-luteal {
  background: rgba(122, 138, 160, 0.12);
  color: #7A8AA0;
}

.phase-day {
  font-size: 28rpx;
  color: #8A6A6A;
}

.calendar-view {
  margin: 20rpx 0;
}

.calendar-legend {
  display: flex;
  gap: 20rpx;
  margin-bottom: 16rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: #8A6A6A;
}

.legend-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 4rpx;
}

.legend-dot.period {
  background: #C45C5C;
}

.legend-dot.fertile {
  background: #D4A828;
}

.legend-dot.today {
  background: #5A8A6A;
}

.calendar-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 8rpx;
}

.day-cell {
  aspect-ratio: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FDF8F8;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #8A6A6A;
}

.day-cell.period {
  background: rgba(196, 92, 92, 0.15);
  color: #C45C5C;
  font-weight: 700;
}

.day-cell.fertile {
  background: rgba(212, 168, 40, 0.15);
  color: #D4A828;
}

.day-cell.today {
  background: #C48B8B;
  color: #fff;
  font-weight: 700;
}

.day-cell.today.period {
  background: linear-gradient(135deg, #C45C5C 50%, #C48B8B 50%);
  color: #fff;
}

.phase-tips {
  background: #FDF8F8;
  padding: 24rpx;
  border-radius: 16rpx;
}

.phase-tip-title {
  display: block;
  font-weight: 600;
  margin-bottom: 8rpx;
  color: #5D4A4A;
  font-size: 26rpx;
}

.phase-tip-text {
  font-size: 26rpx;
  color: #8A6A6A;
  line-height: 1.6;
}

.empty-phase {
  text-align: center;
  padding: 40rpx;
  color: #8A6A6A;
}

/* ========== 生理期设置弹窗 ========== */
.menstrual-settings-body {
  padding: 20rpx 30rpx;
}

.settings-tip {
  text-align: center;
  font-size: 24rpx;
  color: #8A6A6A;
  background: #FDF8F8;
  padding: 16rpx;
  border-radius: 12rpx;
  margin-bottom: 30rpx;
}

.menstrual-settings-body .form-item {
  margin-bottom: 30rpx;
}

.menstrual-settings-body .form-item label {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #5D4A4A;
  margin-bottom: 14rpx;
}

.picker-value {
  height: 80rpx;
  line-height: 80rpx;
  border: 2rpx solid #E8D5D8;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  background: #FDF8F8;
  color: #5D4A4A;
}

.picker-value.placeholder {
  color: #BDBDBD;
}

.stepper-input {
  display: flex;
  align-items: center;
  gap: 0;
  border: 2rpx solid #E8D5D8;
  border-radius: 16rpx;
  overflow: hidden;
  background: #FDF8F8;
}

.stepper-btn {
  width: 80rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  font-size: 36rpx;
  font-weight: 700;
  color: #C48B8B;
  background: #fff;
  flex-shrink: 0;
}

.stepper-btn:active {
  background: #F5EEF0;
}

.stepper-value {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 700;
  color: #5D4A4A;
  border: none;
  background: transparent;
  font-family: monospace;
}

.form-hint {
  display: block;
  font-size: 22rpx;
  color: #BDBDBD;
  margin-top: 10rpx;
}


/* ========== AI饮食计划 ========== */
.ai-hint {
  font-size: 26rpx;
  color: #8A6A6A;
  margin-bottom: 24rpx;
  line-height: 1.6;
}

.plan-history {
  margin-top: 24rpx;
  border-top: 2rpx dashed #E8D5D8;
  padding-top: 24rpx;
}

.plan-history-title {
  font-family: monospace;
  font-size: 22rpx;
  font-weight: 700;
  color: #C48B8B;
  letter-spacing: 2rpx;
  text-transform: uppercase;
  margin-bottom: 16rpx;
}

.plan-history-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  background: #FDF8F8;
  border-radius: 16rpx;
  margin-bottom: 12rpx;
}

.plan-history-info {
  display: flex;
  flex-direction: column;
}

.plan-history-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #5D4A4A;
}

.plan-history-date {
  font-size: 24rpx;
  color: #8A6A6A;
  margin-top: 4rpx;
}

.plan-history-arrow {
  font-size: 36rpx;
  color: #C48B8B;
  font-weight: 700;
}

/* ========== 弹窗 ========== */
.modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(93, 74, 74, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  background: #fff;
  border-radius: 32rpx;
  width: 90%;
  max-height: 80vh;
  overflow: hidden;
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx;
  border-bottom: 2rpx dashed #E8D5D8;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #5D4A4A;
}

.modal-close {
  font-size: 48rpx;
  color: #BDBDBD;
  line-height: 1;
}

.modal-body {
  padding: 30rpx;
  max-height: 60vh;
}

.modal-footer {
  display: flex;
  gap: 20rpx;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  border-top: 2rpx dashed #E8D5D8;
}

.modal-footer button {
  flex: 1;
}

.form-body {
  padding: 30rpx;
}

.form-item {
  margin-bottom: 30rpx;
}

.form-item label {
  display: block;
  font-size: 26rpx;
  color: #8A6A6A;
  margin-bottom: 14rpx;
  font-weight: 600;
}

.form-item input {
  width: 100%;
  height: 80rpx;
  border: 2rpx solid #E8D5D8;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  background: #FDF8F8;
  color: #5D4A4A;
}

/* 饮食计划弹窗 */
.diet-plan-modal {
  width: 95%;
  max-height: 85vh;
}

.plan-tabs {
  display: flex;
  padding: 0 30rpx;
  border-bottom: 2rpx dashed #E8D5D8;
}

.plan-tab {
  flex: 1;
  padding: 22rpx;
  text-align: center;
  font-size: 26rpx;
  color: #8A6A6A;
  position: relative;
  font-weight: 600;
}

.plan-tab.active {
  color: #C48B8B;
}

.plan-tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 4rpx;
  background: #C48B8B;
  border-radius: 2rpx;
}

.phase-info {
  display: flex;
  gap: 30rpx;
  margin-bottom: 16rpx;
}

.phase-info-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.phase-info-item .info-label {
  font-size: 24rpx;
  color: #8A6A6A;
}

.phase-info-item .info-value {
  font-size: 28rpx;
  font-weight: 700;
  color: #C48B8B;
}

.phase-focus-text {
  font-size: 26rpx;
  color: #8A6A6A;
  background: #FDF8F8;
  padding: 20rpx;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  line-height: 1.5;
}

/* 周计划 */
.weekly-plans {
  margin-bottom: 30rpx;
}

.week-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #5D4A4A;
  margin-bottom: 16rpx;
  padding-left: 12rpx;
  border-left: 6rpx solid #C48B8B;
}

.day-plans {
  background: #FDF8F8;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.day-plan-header {
  font-size: 24rpx;
  color: #8A6A6A;
  margin-bottom: 16rpx;
}

.meal-item {
  display: flex;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #E8D5D8;
}

.meal-item:last-child {
  border-bottom: none;
}

.meal-label {
  width: 120rpx;
  font-size: 26rpx;
  color: #8A6A6A;
  flex-shrink: 0;
}

.meal-content {
  flex: 1;
}

.meal-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #5D4A4A;
  display: block;
  margin-bottom: 4rpx;
}

.meal-effect {
  font-size: 24rpx;
  color: #5A8A6A;
  display: block;
  margin-bottom: 4rpx;
}

.meal-ingredients {
  font-size: 24rpx;
  color: #8A6A6A;
}

.ing-label {
  color: #5D4A4A;
}

.meal-item.snacks {
  border-top: 2rpx dashed #E8D5D8;
  margin-top: 8rpx;
  padding-top: 18rpx;
}

.snack-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.snack-list text {
  font-size: 24rpx;
  color: #8A6A6A;
  background: #fff;
  padding: 6rpx 14rpx;
  border-radius: 10rpx;
}

/* 采购清单 */
.shopping-section {
  margin-top: 30rpx;
  border-top: 2rpx dashed #E8D5D8;
  padding-top: 24rpx;
}

.shopping-title {
  font-size: 28rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
  color: #5D4A4A;
}

.shopping-list {
  background: #FDF8F8;
  border-radius: 16rpx;
  padding: 20rpx;
}

.shopping-item {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #E8D5D8;
  font-size: 26rpx;
  color: #5D4A4A;
}

.shopping-item:last-child {
  border-bottom: none;
}

.shopping-icon {
  margin-right: 12rpx;
  font-size: 28rpx;
}

.shopping-name {
  flex: 1;
  font-weight: 500;
}

.shopping-amount {
  color: #C48B8B;
  margin-right: 16rpx;
}

.shopping-period {
  font-size: 24rpx;
  color: #8A6A6A;
}

.shopping-item.need-buy .shopping-name {
  color: #C45C5C;
}

.shopping-item.sufficient .shopping-icon {
  color: #5A8A6A;
}

.plateau-tip {
  display: block;
  margin-top: 12rpx;
  color: #8A6A6A;
}

/* ========== 健康报告卡片 ========== */
.report-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.report-card {
  background: #FDF8F8;
  border-radius: 20rpx;
  padding: 24rpx;
  position: relative;
  overflow: hidden;
}

.report-card::before {
  content: '';
  position: absolute;
  top: 0;
  right: 0;
  width: 0;
  height: 0;
  border-style: solid;
  border-width: 0 48rpx 48rpx 0;
  border-color: transparent #E8D5D8 transparent transparent;
  opacity: 0.5;
}

.report-card::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 4rpx;
  background: repeating-linear-gradient(
    90deg,
    #C48B8B 0rpx,
    #C48B8B 6rpx,
    #E8D5D8 6rpx,
    #E8D5D8 12rpx
  );
}

.report-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.report-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #5D4A4A;
}

.report-date {
  font-size: 24rpx;
  color: #8A6A6A;
}

.report-summary {
  font-size: 26rpx;
  color: #8A6A6A;
  line-height: 1.5;
  margin-bottom: 16rpx;
  padding: 16rpx;
  background: #fff;
  border-radius: 12rpx;
}

.report-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 16rpx;
}

.report-tag {
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
  font-weight: 700;
  background: rgba(90, 138, 106, 0.12);
  color: #5A8A6A;
}

.report-tag.warning {
  background: rgba(212, 168, 40, 0.12);
  color: #D4A828;
}

.report-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 16rpx;
  border-top: 2rpx dashed #E8D5D8;
}

.report-score {
  font-family: monospace;
  font-size: 32rpx;
  font-weight: 700;
  color: #C48B8B;
}

.report-view {
  font-size: 26rpx;
  color: #C48B8B;
  font-weight: 600;
}

/* 健康报告详情弹窗 */
.report-detail-date {
  font-size: 24rpx;
  color: #8A6A6A;
  margin-bottom: 16rpx;
}

.report-detail-summary {
  font-size: 28rpx;
  color: #5D4A4A;
  line-height: 1.6;
  margin-bottom: 24rpx;
  padding: 20rpx;
  background: #FDF8F8;
  border-radius: 16rpx;
}

.report-detail-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 24rpx;
}

.report-detail-score {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 28rpx;
  color: #8A6A6A;
  padding-top: 16rpx;
  border-top: 2rpx dashed #E8D5D8;
}

.score-num {
  font-family: monospace;
  font-size: 48rpx;
  font-weight: 700;
  color: #C48B8B;
}

/* ========== 饮食分析卡片 ========== */
.diet-analysis-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 30rpx;
  margin: 0 24rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(93, 74, 74, 0.08);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #5D4A4A;
}

.analyzing-tip {
  font-size: 24rpx;
  color: #C48B8B;
}

.analysis-summary {
  font-size: 28rpx;
  color: #5D4A4A;
  line-height: 1.6;
  margin-bottom: 24rpx;
  padding: 20rpx;
  background: #FDF8F8;
  border-radius: 16rpx;
}

.needs-section {
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #C48B8B;
  margin-bottom: 16rpx;
  font-family: monospace;
  letter-spacing: 2rpx;
}

.section-title.needs-less {
  color: #D4A828;
}

.need-item {
  margin-bottom: 16rpx;
  padding: 16rpx;
  background: #FDF8F8;
  border-radius: 12rpx;
}

.need-type {
  font-size: 26rpx;
  font-weight: 600;
  color: #5D4A4A;
  margin-bottom: 8rpx;
}

.need-reason {
  font-size: 24rpx;
  color: #8A6A6A;
  margin-bottom: 12rpx;
}

.need-suggestions {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.suggestion-tag {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 16rpx;
  background: rgba(90, 138, 106, 0.12);
  color: #5A8A6A;
  border-radius: 16rpx;
  font-size: 24rpx;
}

.tomorrow-menu {
  border-top: 2rpx dashed #E8D5D8;
  padding-top: 24rpx;
}

.meal-section {
  display: flex;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.meal-label {
  width: 100rpx;
  font-size: 24rpx;
  color: #8A6A6A;
  flex-shrink: 0;
}

.meal-dishes {
  flex: 1;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.dish-chip {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 10rpx 20rpx;
  background: #C48B8B;
  color: #fff;
  border-radius: 20rpx;
  font-size: 26rpx;
}

/* ========== 历史饮食列表 ========== */
.diet-history-section {
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
  margin: 0 24rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(93, 74, 74, 0.08);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #5D4A4A;
}

.toggle-icon {
  color: #C48B8B;
}

.history-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx dashed #E8D5D8;
}

.history-item:last-child {
  border-bottom: none;
}

.history-date {
  font-size: 26rpx;
  color: #8A6A6A;
}

.history-dishes {
  display: flex;
  gap: 8rpx;
}

.history-dishes text {
  font-size: 28rpx;
}

.history-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.history-summary {
  font-size: 24rpx;
  color: #8A6A6A;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 500rpx;
}

.history-actions {
  display: flex;
  gap: 16rpx;
}

.delete-btn {
  font-size: 28rpx;
  padding: 8rpx;
}

/* ========== 锁定状态 ========== */
.diet-analysis-locked {
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx;
  margin: 0 24rpx 24rpx;
  text-align: center;
  font-size: 26rpx;
  color: #8A6A6A;
  box-shadow: 0 4rpx 16rpx rgba(93, 74, 74, 0.08);
}
