/* 健康计划页面样式 */
.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 30rpx;
}

.nav-bar {
  background: linear-gradient(135deg, #722ed1, #531d93);
  color: #fff;
  padding: 60rpx 30rpx 30rpx;
}

.nav-title {
  font-size: 40rpx;
  font-weight: 600;
}

.content {
  height: calc(100vh - 90rpx);
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
}

.edit-btn {
  font-size: 26rpx;
  color: #722ed1;
}

/* 伴侣卡片 */
.partner-card {
  border-left: 6rpx solid #eb7185;
}

.partner-info {
  display: flex;
  gap: 20rpx;
}

.info-item {
  flex: 1;
  text-align: center;
}

.info-item text:first-child {
  display: block;
  font-size: 24rpx;
  color: #999;
}

.info-item text:last-child {
  font-size: 28rpx;
  font-weight: 500;
}

/* 目标选择 */
.goal-selector {
  display: flex;
  gap: 16rpx;
  margin-bottom: 30rpx;
}

.goal-btn {
  flex: 1;
  padding: 20rpx;
  text-align: center;
  border-radius: 16rpx;
  background: #f5f5f5;
  font-size: 28rpx;
  color: #666;
}

.goal-btn.active {
  background: linear-gradient(135deg, #722ed1, #531d93);
  color: #fff;
}

/* 数据概览 */
.data-overview {
  display: flex;
  justify-content: space-around;
  padding: 20rpx 0;
  border-top: 1rpx solid #eee;
  border-bottom: 1rpx solid #eee;
  margin: 20rpx 0;
}

.data-item {
  text-align: center;
}

.data-label {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.data-value {
  font-size: 40rpx;
  font-weight: 600;
}

.data-unit {
  font-size: 24rpx;
  color: #999;
}

/* 活动量 */
.activity-selector {
  margin-bottom: 20rpx;
}

.section-label {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
  display: block;
}

.activity-btns {
  display: flex;
  gap: 12rpx;
}

.activity-btn {
  flex: 1;
  padding: 12rpx;
  text-align: center;
  border-radius: 12rpx;
  background: #f5f5f5;
  font-size: 24rpx;
  color: #666;
}

.activity-btn.active {
  background: #722ed1;
  color: #fff;
}

/* 过敏源 */
.allergy-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.allergy-tag {
  padding: 8rpx 16rpx;
  background: #fff1f0;
  color: #ff4d4f;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.btn-record {
  margin-top: 20rpx;
}

/* 体重趋势图 */
.weight-chart {
  padding: 20rpx 0;
}

.chart-bars {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  height: 120rpx;
  padding-bottom: 40rpx;
}

.chart-bar {
  flex: 1;
  background: linear-gradient(to top, #722ed1, #eb7185);
  border-radius: 4rpx 4rpx 0 0;
  margin: 0 2rpx;
  min-height: 20rpx;
  position: relative;
}

.bar-value {
  position: absolute;
  bottom: -36rpx;
  left: 50%;
  transform: translateX(-50%);
  font-size: 18rpx;
  color: #999;
  white-space: nowrap;
}

.progress-bar {
  height: 12rpx;
  background: #f0f0f0;
  border-radius: 6rpx;
  margin-top: 60rpx;
  overflow: hidden;
}

.progress-inner {
  height: 100%;
  background: linear-gradient(to right, #722ed1, #eb7185);
  border-radius: 6rpx;
  transition: width 0.3s;
}

.progress-label {
  display: flex;
  justify-content: space-between;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #666;
}

/* 生理期 */
.phase-status {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.phase-badge {
  padding: 12rpx 24rpx;
  border-radius: 24rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.phase-menstruation {
  background: #fff1f0;
  color: #ff4d4f;
}

.phase-follicular {
  background: #f6ffed;
  color: #52c41a;
}

.phase-ovulation {
  background: #fff7e6;
  color: #fa8c16;
}

.phase-luteal {
  background: #e6f7ff;
  color: #1890ff;
}

.phase-day {
  font-size: 28rpx;
  color: #666;
}

.calendar-view {
  margin: 20rpx 0;
}

.calendar-legend {
  display: flex;
  gap: 20rpx;
  margin-bottom: 16rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: #666;
}

.legend-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 4rpx;
}

.legend-dot.period {
  background: #ff4d4f;
}

.legend-dot.fertile {
  background: #fa8c16;
}

.legend-dot.today {
  background: #52c41a;
}

.calendar-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 8rpx;
}

.day-cell {
  aspect-ratio: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f5f5f5;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #666;
}

.phase-tips {
  background: #f9f9f9;
  padding: 20rpx;
  border-radius: 12rpx;
}

.phase-tip-title {
  display: block;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.phase-tip-text {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

.empty-phase {
  text-align: center;
  padding: 40rpx;
  color: #999;
}

/* AI饮食计划 */
.ai-hint {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 20rpx;
  line-height: 1.6;
}

/* 弹窗样式 */
.modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  background: #fff;
  border-radius: 24rpx;
  width: 90%;
  max-height: 80vh;
  overflow: hidden;
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx;
  border-bottom: 1rpx solid #eee;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 600;
}

.modal-close {
  font-size: 48rpx;
  color: #999;
}

.modal-body {
  padding: 30rpx;
  max-height: 60vh;
}

.modal-footer {
  display: flex;
  gap: 20rpx;
  padding: 20rpx 30rpx;
  border-top: 1rpx solid #eee;
}

.modal-footer button {
  flex: 1;
}

.form-body {
  padding: 30rpx;
}

.form-item {
  margin-bottom: 30rpx;
}

.form-item label {
  display: block;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.form-item input {
  width: 100%;
  height: 80rpx;
  border: 1rpx solid #ddd;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

/* 饮食计划弹窗 */
.plan-phase {
  padding: 24rpx;
  background: #f9f9f9;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
}

.phase-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #722ed1;
  margin-bottom: 12rpx;
}

.phase-detail {
  display: flex;
  gap: 20rpx;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.phase-focus {
  font-size: 26rpx;
  color: #999;
}

.plan-tips {
  margin-top: 20rpx;
}

.tips-title {
  display: block;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.plateau-tip {
  display: block;
  margin-top: 12rpx;
  color: #666;
}
