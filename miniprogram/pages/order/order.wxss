/* 点餐页面 — Pop Style */
.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #FDF8F8 0%, #F5EEF0 100%);
  padding-bottom: 160rpx;
}

/* ========== 主体布局：侧边栏 + 列表 ========== */
.content-wrapper {
  display: flex;
  height: calc(100vh - 280rpx);
}

/* ========== 分类侧边栏 ========== */
.category-sidebar {
  width: 160rpx;
  background: #F5F0F0;
  flex-shrink: 0;
}

.sidebar-item {
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #5D4A4A;
  position: relative;
  transition: all 0.2s;
}

.sidebar-item.active {
  background: #fff;
  color: #C48B8B;
}

.sidebar-item.active::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 6rpx;
  background: #C48B8B;
}

/* ========== 菜品列表区域 ========== */
.food-list-area {
  flex: 1;
  padding: 0 24rpx;
}

/* ========== 导航栏 ========== */
.nav-bar {
  background: linear-gradient(135deg, #E8D5D8 0%, #C48B8B 100%);
  padding: 60rpx 30rpx 30rpx;
  position: relative;
}

.nav-bar::after {
  content: '';
  position: absolute;
  bottom: -20rpx;
  left: 0;
  right: 0;
  height: 40rpx;
  background: #F5EEF0;
  border-radius: 20rpx 20rpx 0 0;
}

.nav-title {
  font-size: 44rpx;
  font-weight: 600;
  color: #5D4A4A;
  letter-spacing: 2rpx;
}

/* ========== 搜索栏 ========== */
.search-bar {
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 0 24rpx 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(93, 74, 74, 0.08);
  position: relative;
  overflow: hidden;
}

.search-bar::before {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 4rpx;
  background: repeating-linear-gradient(
    90deg,
    #C48B8B 0rpx,
    #C48B8B 6rpx,
    #E8D5D8 6rpx,
    #E8D5D8 12rpx
  );
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #5D4A4A;
  background: transparent;
}

.search-input::placeholder {
  color: #BDBDBD;
}

/* ========== 分类栏 ========== */
.category-bar {
  display: flex;
  gap: 10rpx;
  padding: 0 24rpx 16rpx;
  flex-wrap: wrap;
}

.category-item {
  padding: 12rpx 28rpx;
  background: #fff;
  border-radius: 32rpx;
  font-family: monospace;
  font-size: 24rpx;
  font-weight: 700;
  color: #8A6A6A;
  border: 2rpx solid #E8D5D8;
  transition: all 0.2s;
  flex-shrink: 0;
}

.category-item.active {
  background: #C48B8B;
  color: #fff;
  border-color: #C48B8B;
}

/* ========== 菜品列表 ========== */
.food-list {
}

.food-card {
  background: #fff;
  border-radius: 24rpx;
  margin-bottom: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(93, 74, 74, 0.08);
  position: relative;
}

.food-card::before {
  content: '';
  position: absolute;
  top: 0;
  right: 0;
  width: 0;
  height: 0;
  border-style: solid;
  border-width: 0 48rpx 48rpx 0;
  border-color: transparent #E8D5D8 transparent transparent;
  opacity: 0.4;
  z-index: 0;
}

.food-card::after {
  content: '';
  position: absolute;
  bottom: 8rpx;
  right: 8rpx;
  width: 14rpx;
  height: 14rpx;
  background: #C48B8B;
  border-radius: 50%;
  opacity: 0.3;
}

.food-card.has-conflict {
  border-left: 6rpx solid #C45C5C;
}

.food-card.is-added {
  opacity: 0.7;
}

.food-main {
  display: flex;
  align-items: center;
  padding: 28rpx;
  position: relative;
  z-index: 1;
}

.food-emoji {
  font-size: 56rpx;
  margin-right: 22rpx;
}

.food-info {
  flex: 1;
}

.food-name {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #5D4A4A;
  margin-bottom: 6rpx;
}

.food-tags {
  display: flex;
  gap: 10rpx;
}

.heat-tag {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  font-weight: 700;
}

.heat-tag.safe {
  background: rgba(90, 138, 106, 0.12);
  color: #5A8A6A;
}

.heat-tag.danger {
  background: rgba(196, 92, 92, 0.12);
  color: #C45C5C;
}

.heat-tag.steam {
  background: rgba(212, 168, 40, 0.12);
  color: #D4A828;
}

.heat-tag.fire {
  background: rgba(122, 138, 160, 0.12);
  color: #7A8AA0;
}

.conflict-tag {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  font-weight: 700;
  background: rgba(212, 168, 40, 0.12);
  color: #D4A828;
}

.food-ingredients {
  font-size: 24rpx;
  color: #8A6A6A;
  margin-top: 8rpx;
}

.food-action {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 12rpx;
  padding: 16rpx 28rpx;
  border-top: 2rpx dashed #E8D5D8;
  position: relative;
  z-index: 1;
}

.add-btn {
  padding: 14rpx 36rpx;
  background: #C48B8B;
  color: #fff;
  border-radius: 24rpx;
  font-size: 26rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(196, 139, 139, 0.3);
}

.added-text {
  font-size: 26rpx;
  color: #8A6A6A;
}

.remove-btn {
  font-size: 26rpx;
  color: #C45C5C;
  padding: 8rpx 16rpx;
}

/* ========== 添加新菜品按钮 ========== */
.custom-dish-btn-wrap {
  padding: 16rpx 24rpx;
}

.custom-dish-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #E8D5D8 0%, #F5EEF0 100%);
  border: 2rpx dashed #C48B8B;
  border-radius: 24rpx;
}

.custom-dish-btn-icon {
  font-size: 40rpx;
  font-weight: 700;
  color: #C48B8B;
  line-height: 1;
}

.custom-dish-btn-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #C48B8B;
  letter-spacing: 2rpx;
}

/* ========== 弹窗 ========== */
.modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(93, 74, 74, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  background: #fff;
  border-radius: 32rpx;
  width: 90%;
  max-height: 80vh;
  overflow: hidden;
  overflow-x: hidden;
  box-sizing: border-box;
}

.modal-lg {
  width: 95%;
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx;
  border-bottom: 2rpx dashed #E8D5D8;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #5D4A4A;
}

.modal-close {
  font-size: 48rpx;
  color: #BDBDBD;
  line-height: 1;
}

.modal-body {
  padding: 30rpx;
  max-height: 60vh;
  box-sizing: border-box;
}

.modal-emoji {
  font-size: 100rpx;
  text-align: center;
  margin-bottom: 24rpx;
}

.section {
  margin-bottom: 30rpx;
}

.section-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #C48B8B;
  margin-bottom: 16rpx;
  font-family: monospace;
  letter-spacing: 2rpx;
  text-transform: uppercase;
}

.ingredient-list {
  background: #FDF8F8;
  border-radius: 16rpx;
  padding: 20rpx;
}

.ingredient-item {
  display: flex;
  justify-content: space-between;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #E8D5D8;
  font-size: 26rpx;
  color: #5D4A4A;
}

.ingredient-item:last-child {
  border-bottom: none;
}

.amount {
  color: #8A6A6A;
}

.step-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.step-item {
  display: flex;
  align-items: flex-start;
}

.step-num {
  width: 44rpx;
  height: 44rpx;
  background: #C48B8B;
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.step-text {
  flex: 1;
  font-size: 28rpx;
  line-height: 1.6;
  color: #5D4A4A;
}

.heat-info {
  font-size: 28rpx;
  color: #8A6A6A;
  padding: 20rpx;
  background: #FDF8F8;
  border-radius: 16rpx;
}

/* 自定义菜品表单 */
.form-body {
  padding: 30rpx;
  max-height: 60vh;
  box-sizing: border-box;
}

.form-item {
  margin-bottom: 30rpx;
  box-sizing: border-box;
}

.form-item label {
  display: block;
  font-size: 26rpx;
  color: #8A6A6A;
  margin-bottom: 14rpx;
  font-weight: 600;
}

.form-item input,
.form-item textarea {
  width: 100%;
  border: 2rpx solid #E8D5D8;
  border-radius: 16rpx;
  padding: 22rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  background: #FDF8F8;
  color: #5D4A4A;
  margin: 0;
}

.form-item textarea {
  height: 160rpx;
  line-height: 1.6;
}

.name-input {
  height: 96rpx !important;
  font-size: 34rpx !important;
  font-weight: 600 !important;
  padding: 0 28rpx !important;
  border-radius: 20rpx !important;
  border: 2rpx solid #C48B8B !important;
  background: #fff !important;
}

.name-placeholder {
  font-size: 28rpx;
  font-weight: 400;
  color: #BDBDBD;
}

.emoji-picker {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.emoji-option {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  border-radius: 16rpx;
  background: #FDF8F8;
  border: 2rpx solid transparent;
}

.emoji-option.selected {
  background: #E8D5D8;
  border-color: #C48B8B;
}

.form-item radio-group {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.form-item radio-group label {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
  font-weight: 400;
  color: #5D4A4A;
}

.modal-footer {
  display: flex;
  gap: 20rpx;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  border-top: 2rpx dashed #E8D5D8;
}

.modal-footer button {
  flex: 1;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.empty-state .icon {
  font-size: 100rpx;
}

.empty-state .text {
  font-size: 28rpx;
  color: #8A6A6A;
  margin-top: 20rpx;
}

/* ========== 底部餐次选择弹窗 ========== */
.meal-picker-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(93, 74, 74, 0.5);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.meal-picker-content {
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  width: 100%;
  padding: 40rpx 30rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.meal-picker-title {
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #5D4A4A;
  margin-bottom: 30rpx;
}

.meal-picker-btns {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.meal-picker-btn {
  flex: 1;
  height: 88rpx;
  background: #FDF8F8;
  border: 2rpx solid #E8D5D8;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #5D4A4A;
  font-weight: 600;
}

.meal-picker-btn:active {
  background: #E8D5D8;
}

.meal-picker-cancel {
  text-align: center;
  font-size: 28rpx;
  color: #8A6A6A;
  padding: 20rpx;
}
