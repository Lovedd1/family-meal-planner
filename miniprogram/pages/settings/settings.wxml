<!-- 设置页面 -->
<view class="page">
  <!-- 顶部导航 -->
  <view class="nav-bar">
    <view class="nav-title">设置</view>
  </view>

  <!-- 用户信息 -->
  <view class="section">
    <view class="user-card" bindtap="{{userInfo.hasLogin ? 'showEditNickname' : 'loginWithWechat'}}">
      <view class="avatar" wx:if="{{userInfo.avatarUrl}}">
        <image src="{{userInfo.avatarUrl}}" mode="aspectFill" class="avatar-img"/>
      </view>
      <view class="avatar" wx:else>{{userInfo.avatar}}</view>
      <view class="user-info">
        <text class="nickname">{{userInfo.nickname}}</text>
        <text class="login-hint" wx:if="{{!userInfo.hasLogin}}">点击登录微信账号</text>
        <text class="collab-status" wx:else>
          <text class="status-dot {{partnerInfo.connected ? 'connected' : ''}}"></text>
          与{{partnerInfo.connected ? partnerInfo.nickname : '未连接'}}协作中
        </text>
      </view>
      <view class="edit-btn" wx:if="{{userInfo.hasLogin}}">编辑</view>
    </view>
  </view>

  <!-- 数据同步 -->
  <view class="section">
    <view class="section-title">数据同步</view>
    <view class="sync-card">
      <view class="sync-status">
        <view class="status-indicator {{syncStatus}}">
          <view class="status-dot"></view>
          <text>{{getSyncStatusText(syncStatus)}}</text>
        </view>
        <text class="last-sync" wx:if="{{lastSyncTime}}">上次同步: {{lastSyncTime}}</text>
      </view>
      <button class="btn btn-outline" bindtap="syncData">手动同步</button>
    </view>

    <view class="data-stats">
      <view class="stat-item">
        <text class="stat-value">{{dataStats.fridgeItems}}</text>
        <text class="stat-label">冰箱食材</text>
      </view>
      <view class="stat-item">
        <text class="stat-value">{{dataStats.customFoods}}</text>
        <text class="stat-label">自定义菜品</text>
      </view>
      <view class="stat-item">
        <text class="stat-value">{{dataStats.weightRecords}}</text>
        <text class="stat-label">体重记录</text>
      </view>
    </view>

    <view class="action-item" bindtap="exportData">
      <text class="action-icon">📥</text>
      <text class="action-text">导出JSON数据</text>
      <text class="arrow">›</text>
    </view>
  </view>

  <!-- 伴侣信息 -->
  <view class="section" wx:if="{{partnerInfo.connected}}">
    <view class="section-title">TA的信息</view>
    <view class="partner-card">
      <view class="partner-avatar">{{partnerInfo.nickname}}</view>
      <view class="partner-name">{{partnerInfo.nickname}}</view>
      <button class="btn-small" bindtap="unbindPartner">解除绑定</button>
    </view>
  </view>

  <!-- 绑定按钮（未绑定时显示） -->
  <view class="section" wx:if="{{!partnerInfo.connected}}">
    <button class="btn-primary" bindtap="showBindPartner">绑定伴侣</button>
  </view>

  <!-- 绑定弹窗 -->
  <view class="modal" wx:if="{{showBindPartnerModal}}" bindtap="closeBindPartnerModal">
    <view class="modal-content" catchtap="">
      <view class="modal-header">
        <text class="modal-title">绑定伴侣</text>
        <text class="modal-close" bindtap="closeBindPartnerModal">×</text>
      </view>
      <view class="modal-body">
        <view class="bind-modal-content">
          <!-- 我的邀请码 -->
          <view class="invite-code-section">
            <view class="section-title">我的邀请码</view>
            <view wx:if="{{inviteCode}}" class="invite-code">{{inviteCode}}</view>
            <button wx:if="{{!inviteCode}}" loading="{{isGeneratingCode}}" bindtap="generateInviteCode">
              生成邀请码
            </button>
            <button wx:if="{{inviteCode}}" class="btn-small" bindtap="copyInviteCode">复制</button>
          </view>

          <!-- 输入伴侣邀请码 -->
          <view class="bind-input-section">
            <view class="section-title">输入TA的邀请码</view>
            <form bindsubmit="bindWithCode" catchtap="preventBubble">
              <input name="code" maxlength="6" placeholder="请输入6位邀请码" class="code-input"/>
              <button form-type="submit" loading="{{isBinding}}" class="btn-primary">确认绑定</button>
            </form>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 生理期追踪 -->
  <view class="section">
    <view class="section-title">生理期追踪</view>
    <view class="menstrual-card">
      <view class="menstrual-item">
        <text class="menstrual-label">上次月经日期</text>
        <text class="menstrual-value">{{menstrualSettings.lastPeriodDate || '未设置'}}</text>
      </view>
      <view class="menstrual-item">
        <text class="menstrual-label">当前阶段</text>
        <text class="menstrual-value phase-{{menstrualSettings.currentPhase}}">
          {{getPhaseText(menstrualSettings.currentPhase)}}
        </text>
      </view>
      <view class="menstrual-item">
        <text class="menstrual-label">月经周期</text>
        <text class="menstrual-value">{{menstrualSettings.cycleDays || 28}}天</text>
      </view>
    </view>
  </view>

  <!-- 关于 -->
  <view class="section">
    <view class="section-title">关于</view>
    <view class="about-list">
      <view class="about-item" bindtap="showPrivacy">
        <text class="about-icon">🔒</text>
        <text class="about-text">隐私声明</text>
        <text class="arrow">›</text>
      </view>
      <view class="about-item">
        <text class="about-icon">📖</text>
        <text class="about-text">使用说明</text>
        <text class="arrow">›</text>
      </view>
      <view class="about-item">
        <text class="about-icon">ℹ️</text>
        <text class="about-text">版本信息</text>
        <text class="version">{{version}}</text>
      </view>
    </view>
  </view>

  <!-- 危险操作 -->
  <view class="section">
    <view class="danger-zone">
      <view class="action-item danger" bindtap="showResetConfirm">
        <text class="action-icon">🗑️</text>
        <text class="action-text">重置所有数据</text>
        <text class="arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 隐私声明弹窗 -->
  <view class="modal" wx:if="{{showPrivacyModal}}" bindtap="closePrivacyModal">
    <view class="modal-content" catchtap="">
      <view class="modal-header">
        <text class="modal-title">隐私声明</text>
        <text class="modal-close" bindtap="closePrivacyModal">×</text>
      </view>
      <scroll-view class="modal-body" scroll-y>
        <view class="privacy-item">
          <text class="privacy-icon">🔒</text>
          <view class="privacy-text">
            <text class="privacy-title">数据本地存储</text>
            <text class="privacy-desc">所有健康数据仅存储在您的设备本地</text>
          </view>
        </view>
        <view class="privacy-item">
          <text class="privacy-icon">☁️</text>
          <view class="privacy-text">
            <text class="privacy-title">云开发同步</text>
            <text class="privacy-desc">如启用云开发，数据将在加密后同步至腾讯云</text>
          </view>
        </view>
        <view class="privacy-item">
          <text class="privacy-icon">🤖</text>
          <view class="privacy-text">
            <text class="privacy-title">AI饮食建议</text>
            <text class="privacy-desc">仅在生成建议时向DeepSeek发送必要健康参数</text>
          </view>
        </view>
        <view class="privacy-item">
          <text class="privacy-icon">🚫</text>
          <view class="privacy-text">
            <text class="privacy-title">不收集无关信息</text>
            <text class="privacy-desc">我们不会收集您的位置、通讯录等无关信息</text>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>
</view>
