<!-- 设置页面 -->
<wxs module="utils">
module.exports = {
  formatSyncTime: function(timestamp) {
    if (!timestamp) return '从未同步'
    var diff = Date.now() - timestamp
    if (diff < 60000) return '刚刚'
    if (diff < 3600000) return Math.floor(diff / 60000) + '分钟前'
    if (diff < 86400000) return Math.floor(diff / 3600000) + '小时前'
    var date = getDate(timestamp)
    return (date.getMonth() + 1) + '月' + date.getDate() + '日'
  }
}
</wxs>
<view class="page">
  <!-- 顶部导航 -->
  <view class="nav-bar">
    <view class="nav-title">设置</view>
  </view>

  <!-- 我的信息卡片 -->
  <view class="section">
    <view class="user-card">
      <view class="avatar-sm">🤝</view>
      <view class="user-info">
        <text class="nickname">{{myNickname || '未设置'}}</text>
        <text class="login-hint" wx:if="{{!myNickname}}">设置昵称和PIN码开启配对</text>
        <text class="collab-status" wx:if="{{myNickname}}">
          <text class="status-dot {{partnerConnected ? 'connected' : ''}}"></text>
          {{partnerConnected ? '已与' + partnerNickname + '配对' : '等待配对'}}
        </text>
      </view>
      <view class="edit-btn" bindtap="openMyInfoModal">编辑</view>
    </view>
  </view>

  <!-- TA的信息（已配对时显示） -->
  <view class="section" wx:if="{{partnerConnected}}">
    <view class="section-title">TA的信息</view>
    <view class="partner-card">
      <view class="partner-avatar-sm">💕</view>
      <view class="partner-name">{{partnerNickname}}</view>
      <button class="btn-small danger" bindtap="unpairPartner">解除绑定</button>
    </view>
  </view>

  <!-- 配对区域 -->
  <view class="section" wx:if="{{!partnerConnected && myNickname}}">
    <view class="section-title">绑定伴侣</view>
    <view class="pair-hint">向伴侣询问TA的昵称和PIN码，即可完成配对</view>
    <button class="btn-primary" bindtap="openPairModal">绑定伴侣</button>
  </view>

  <!-- 提示（未设置昵称时） -->
  <view class="section" wx:if="{{!myNickname}}">
    <view class="pair-hint center">设置我的信息后，即可与伴侣配对共享数据</view>
  </view>

  <!-- 数据同步（已配对时显示） -->
  <view class="section" wx:if="{{partnerConnected}}">
    <view class="section-title">数据同步</view>
    <view class="sync-card">
      <view class="sync-status">
        <view class="status-indicator {{syncStatus}}">
          <text class="status-dot"></text>
          <text>{{syncStatus === 'syncing' ? '同步中...' : (syncStatus === 'connected' ? '已连接' : '未连接')}}</text>
        </view>
        <text class="last-sync">{{utils.formatSyncTime(lastSyncTime)}}</text>
      </view>
      <button class="btn-outline" bindtap="manualSync" loading="{{syncing}}" disabled="{{syncing}}">
        {{syncing ? '同步中...' : '立即同步'}}
      </button>
    </view>
  </view>

  <!-- 数据统计 -->
  <view class="section">
    <view class="section-title">数据统计</view>
    <view class="data-stats">
      <view class="stat-item">
        <text class="stat-value">{{dataStats.fridgeItems}}</text>
        <text class="stat-label">冰箱食材</text>
      </view>
      <view class="stat-item">
        <text class="stat-value">{{dataStats.customFoods}}</text>
        <text class="stat-label">自定义菜品</text>
      </view>
      <view class="stat-item">
        <text class="stat-value">{{dataStats.weightRecords}}</text>
        <text class="stat-label">体重记录</text>
      </view>
    </view>
    <view class="action-item" bindtap="goToCookingRecord">
      <text class="action-icon">🍳</text>
      <text class="action-text">做饭记录</text>
      <text class="arrow">›</text>
    </view>
    <view class="action-item" bindtap="exportData">
      <text class="action-icon">📥</text>
      <text class="action-text">导出JSON数据</text>
      <text class="arrow">›</text>
    </view>
  </view>

  <!-- 生理期追踪 -->
  <view class="section">
    <view class="section-title">生理期追踪</view>
    <view class="menstrual-card">
      <view class="menstrual-item">
        <text class="menstrual-label">上次月经日期</text>
        <text class="menstrual-value">{{menstrualSettings.lastPeriodDate || '未设置'}}</text>
      </view>
      <view class="menstrual-item">
        <text class="menstrual-label">当前阶段</text>
        <text class="menstrual-value phase-{{menstrualSettings.currentPhase}}">
          {{getPhaseText(menstrualSettings.currentPhase)}}
        </text>
      </view>
      <view class="menstrual-item">
        <text class="menstrual-label">月经周期</text>
        <text class="menstrual-value">{{menstrualSettings.cycleDays || 28}}天</text>
      </view>
    </view>
  </view>

  <!-- 关于 -->
  <view class="section">
    <view class="section-title">关于</view>
    <view class="about-list">
      <view class="about-item" bindtap="showPrivacy">
        <text class="about-icon">🔒</text>
        <text class="about-text">隐私声明</text>
        <text class="arrow">›</text>
      </view>
      <view class="about-item">
        <text class="about-icon">ℹ️</text>
        <text class="about-text">版本信息</text>
        <text class="version">{{version}}</text>
      </view>
    </view>
  </view>

  <!-- 危险操作 -->
  <view class="section">
    <view class="danger-zone">
      <view class="action-item danger" bindtap="showResetConfirm">
        <text class="action-icon">🗑️</text>
        <text class="action-text">重置所有数据</text>
        <text class="arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 我的信息弹窗 -->
  <view class="modal" wx:if="{{showMyInfoModal}}">
    <view class="modal-content" catchtap="">
      <view class="modal-header">
        <text class="modal-title">设置我的信息</text>
        <text class="modal-close" bindtap="closeMyInfoModal">×</text>
      </view>
      <view class="modal-body">
        <view class="form-item">
          <label>我的昵称</label>
          <input
            class="pin-input"
            type="text"
            maxlength="10"
            value="{{tempMyNickname}}"
            bindinput="onNicknameInput"
            placeholder="给自己起个昵称（最多10字）"
          />
        </view>
        <view class="form-item">
          <label>我的PIN码（4位数字）</label>
          <input
            class="pin-input pin-code"
            type="number"
            maxlength="4"
            value="{{tempMyPin}}"
            bindinput="onPinInput"
            placeholder="设置4位数字PIN码"
          />
          <text class="form-hint">PIN码将用于与伴侣配对，请牢记</text>
        </view>
      </view>
      <view class="modal-footer">
        <button type="default" catchtap="closeMyInfoModal">取消</button>
        <button type="primary" bindtap="saveMyInfo" loading="{{savingInfo}}">保存</button>
      </view>
    </view>
  </view>

  <!-- 配对弹窗 -->
  <view class="modal" wx:if="{{showPairModal}}">
    <view class="modal-content" catchtap="">
      <view class="modal-header">
        <text class="modal-title">绑定伴侣</text>
        <text class="modal-close" bindtap="closePairModal">×</text>
      </view>
      <view class="modal-body">
        <view class="pair-step">
          <view class="pair-step-num">1</view>
          <view class="pair-step-text">请输入TA的昵称和PIN码</view>
        </view>
        <view class="form-item">
          <label>伴侣昵称</label>
          <input
            class="pin-input"
            type="text"
            maxlength="10"
            value="{{tempPartnerNickname}}"
            bindinput="onPartnerNicknameInput"
            placeholder="TA给自己起的昵称"
          />
        </view>
        <view class="form-item">
          <label>伴侣PIN码</label>
          <input
            class="pin-input pin-code"
            type="number"
            maxlength="4"
            value="{{tempPartnerPin}}"
            bindinput="onPartnerPinInput"
            placeholder="TA设置的4位PIN码"
          />
        </view>
      </view>
      <view class="modal-footer">
        <button type="default" catchtap="closePairModal">取消</button>
        <button type="primary" bindtap="doPair" loading="{{pairing}}">确认配对</button>
      </view>
    </view>
  </view>

  <!-- 隐私声明弹窗 -->
  <view class="modal" wx:if="{{showPrivacyModal}}">
    <view class="modal-content" catchtap="">
      <view class="modal-header">
        <text class="modal-title">隐私声明</text>
        <text class="modal-close" bindtap="closePrivacyModal">×</text>
      </view>
      <scroll-view class="modal-body" scroll-y>
        <view class="privacy-item">
          <text class="privacy-icon">🔒</text>
          <view class="privacy-text">
            <text class="privacy-title">数据本地存储</text>
            <text class="privacy-desc">所有健康数据仅存储在您的设备本地</text>
          </view>
        </view>
        <view class="privacy-item">
          <text class="privacy-icon">🤝</text>
          <view class="privacy-text">
            <text class="privacy-title">伴侣配对</text>
            <text class="privacy-desc">配对使用昵称+PIN码，数据通过云端加密同步。请勿泄露PIN码给他人</text>
          </view>
        </view>
        <view class="privacy-item">
          <text class="privacy-icon">☁️</text>
          <view class="privacy-text">
            <text class="privacy-title">云端同步</text>
            <text class="privacy-desc">配对数据存储在腾讯云开发数据库中，仅配对双方可访问</text>
          </view>
        </view>
        <view class="privacy-item">
          <text class="privacy-icon">🤖</text>
          <view class="privacy-text">
            <text class="privacy-title">AI饮食建议</text>
            <text class="privacy-desc">仅在生成建议时向DeepSeek发送必要健康参数</text>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>
</view>
