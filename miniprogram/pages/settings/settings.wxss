/* 设置页面样式 */
.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 60rpx;
}

.nav-bar {
  background: linear-gradient(135deg, #1f1f1f, #333);
  color: #fff;
  padding: 60rpx 30rpx 30rpx;
}

.nav-title {
  font-size: 40rpx;
  font-weight: 600;
}

.section {
  padding: 0 20rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 26rpx;
  color: #999;
  padding: 20rpx 10rpx 10rpx;
}

/* 用户卡片 */
.user-card {
  display: flex;
  align-items: center;
  background: #fff;
  padding: 30rpx;
  border-radius: 20rpx;
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  background: linear-gradient(135deg, #07c160, #10b266);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  color: #fff;
  font-weight: 600;
  margin-right: 24rpx;
}

.user-info {
  flex: 1;
}

.nickname {
  font-size: 36rpx;
  font-weight: 600;
  display: block;
}

.collab-status {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.status-dot {
  width: 12rpx;
  height: 12rpx;
  background: #ddd;
  border-radius: 50%;
}

.status-dot.connected {
  background: #52c41a;
}

.edit-btn {
  font-size: 28rpx;
  color: #1890ff;
}

/* 同步卡片 */
.sync-card {
  background: #fff;
  padding: 30rpx;
  border-radius: 20rpx;
  margin-bottom: 16rpx;
}

.sync-status {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.status-indicator {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.status-indicator .status-dot {
  width: 16rpx;
  height: 16rpx;
  background: #ddd;
  border-radius: 50%;
}

.status-indicator.connected .status-dot {
  background: #52c41a;
}

.status-indicator.syncing .status-dot {
  background: #fa8c16;
  animation: pulse 1s infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}

.last-sync {
  font-size: 24rpx;
  color: #999;
}

.btn-outline {
  border: 2rpx solid #ddd;
  background: #fff;
  color: #333;
  border-radius: 40rpx;
}

/* 数据统计 */
.data-stats {
  display: flex;
  gap: 16rpx;
  background: #fff;
  padding: 30rpx;
  border-radius: 20rpx;
  margin-bottom: 16rpx;
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-value {
  font-size: 36rpx;
  font-weight: 600;
  display: block;
}

.stat-label {
  font-size: 24rpx;
  color: #999;
}

/* 操作项 */
.action-item {
  display: flex;
  align-items: center;
  background: #fff;
  padding: 30rpx;
  border-radius: 20rpx;
  margin-bottom: 16rpx;
}

.action-item .action-icon {
  font-size: 40rpx;
  margin-right: 16rpx;
}

.action-item .action-text {
  flex: 1;
  font-size: 30rpx;
}

.action-item .arrow {
  font-size: 36rpx;
  color: #ccc;
}

.action-item.danger .action-text {
  color: #ff4d4f;
}

/* 生理期卡片 */
.menstrual-card {
  background: #fff;
  padding: 30rpx;
  border-radius: 20rpx;
}

.menstrual-item {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.menstrual-item:last-child {
  border-bottom: none;
}

.menstrual-label {
  font-size: 28rpx;
  color: #666;
}

.menstrual-value {
  font-size: 28rpx;
  color: #333;
}

.menstrual-value.phase-menstruation {
  color: #ff4d4f;
}

.menstrual-value.phase-follicular {
  color: #52c41a;
}

.menstrual-value.phase-ovulation {
  color: #fa8c16;
}

.menstrual-value.phase-luteal {
  color: #1890ff;
}

/* 关于列表 */
.about-list {
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
}

.about-item {
  display: flex;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.about-item:last-child {
  border-bottom: none;
}

.about-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
}

.about-text {
  flex: 1;
  font-size: 30rpx;
}

.version {
  font-size: 26rpx;
  color: #999;
}

/* 危险区域 */
.danger-zone {
  margin-top: 40rpx;
}

/* 弹窗样式 */
.modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  background: #fff;
  border-radius: 24rpx;
  width: 90%;
  max-height: 80vh;
  overflow: hidden;
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx;
  border-bottom: 1rpx solid #eee;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 600;
}

.modal-close {
  font-size: 48rpx;
  color: #999;
}

.modal-body {
  padding: 30rpx;
  max-height: 60vh;
}

.privacy-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 30rpx;
}

.privacy-icon {
  font-size: 40rpx;
  margin-right: 16rpx;
}

.privacy-text {
  flex: 1;
}

.privacy-title {
  display: block;
  font-size: 30rpx;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.privacy-desc {
  display: block;
  font-size: 26rpx;
  color: #999;
  line-height: 1.6;
}

/* 伴侣卡片 */
.partner-card {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: #fff;
  border-radius: 12rpx;
}

.partner-avatar {
  width: 80rpx;
  height: 80rpx;
  background: #07c160;
  color: white;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}

.partner-name {
  flex: 1;
  margin-left: 20rpx;
  font-size: 32rpx;
}

/* 绑定弹窗 */
.bind-modal-content {
  padding: 20rpx;
}

.invite-code-section {
  text-align: center;
  margin-bottom: 40rpx;
}

.invite-code {
  font-size: 48rpx;
  font-weight: bold;
  letter-spacing: 8rpx;
  color: #07c160;
  margin: 20rpx 0;
}

.bind-input-section {
  margin-top: 20rpx;
}

.code-input {
  border: 1px solid #ddd;
  padding: 20rpx;
  border-radius: 8rpx;
  text-align: center;
  font-size: 36rpx;
  letter-spacing: 8rpx;
  margin-bottom: 20rpx;
}

.btn-primary {
  background: #07c160;
  color: white;
  border-radius: 40rpx;
  width: 100%;
}

.btn-small {
  font-size: 24rpx;
  padding: 10rpx 20rpx;
  border: 1px solid #ddd;
  border-radius: 20rpx;
  background: white;
}
