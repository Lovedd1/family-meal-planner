<!-- 今日菜单页面 -->
<view class="page">
  <!-- 顶部导航 -->
  <view class="nav-bar">
    <view class="nav-title">今日菜单</view>
    <view class="date-title">{{currentDate}}</view>
  </view>

  <!-- 餐次Tab -->
  <view class="tab-bar">
    <view
      wx:for="{{tabs}}"
      wx:key="key"
      class="tab-item {{currentTab === item.key ? 'active' : ''}}"
      data-tab="{{item.key}}"
      bindtap="switchTab"
    >
      <text>{{item.label}}</text>
      <view class="tab-badge" wx:if="{{item.count > 0}}">{{item.count}}</view>
    </view>
    <view class="tab-item {{currentTab === 'nutrition' ? 'active' : ''}}" data-tab="nutrition" bindtap="switchTab">
      <text>📊 营养</text>
    </view>
  </view>

  <!-- 相克警告 -->
  <view class="conflict-banner" wx:if="{{conflicts.length > 0}}">
    <text class="conflict-icon">⚠️</text>
    <text class="conflict-text">当前菜单存在食材搭配风险</text>
  </view>

  <!-- 菜品列表 -->
  <view class="dish-list" wx:if="{{currentTab !== 'nutrition'}}">
    <block wx:if="{{menu[currentTab].length > 0}}">
      <view
        class="dish-card"
        wx:for="{{menu[currentTab]}}"
        wx:key="id"
        data-dish="{{item}}"
        bindtap="showRecipe"
      >
        <view class="dish-left">
          <text class="dish-emoji">{{item.emoji}}</text>
          <view class="dish-info">
            <view class="dish-name">
              <text>{{item.name}}</text>
              <view class="tag tag-info" wx:if="{{item.isCustom}}">自定义</view>
              <view class="tag nutrition-tag {{nType}}" wx:for="{{item.nutritionTypes}}" wx:key="*this" wx:for-item="nType">
                {{nType === 'carbs' ? '碳水' : nType === 'protein' ? '蛋白质' : nType === 'fat' ? '脂肪' : '纤维'}}
              </view>
            </view>
            <view class="dish-tags">
              <view class="heat-tag {{item.heatMethod === 'microwave_safe' ? 'tag-success' : item.heatMethod === 'microwave_none' ? 'tag-danger' : item.heatMethod === 'steam_only' ? 'tag-warning' : 'tag-info'}}">
                {{item.heatMethod === 'microwave_safe' ? '✅微波安全' : item.heatMethod === 'microwave_none' ? '🔴禁微波' : item.heatMethod === 'steam_only' ? '🟢仅蒸制' : '🟠仅明火'}}
              </view>
              <view class="conflict-tag tag-danger" wx:if="{{item.hasConflict}}">
                ⚠️ 可能相克
              </view>
            </view>
          </view>
        </view>
        <view
          class="dish-remove"
          data-tab="{{currentTab}}"
          data-index="{{index}}"
          catchtap="removeDish"
        >
          <text>×</text>
        </view>
      </view>
    </block>
    <view class="empty-state" wx:else>
      <text class="icon">🍽️</text>
      <text class="text">暂无菜品</text>
      <text class="text-small">去点餐页面添加</text>
    </view>
  </view>

  <!-- 营养Tab内容 -->
  <view class="nutrition-tab" wx:if="{{currentTab === 'nutrition'}}">
    <!-- 营养分布概览 -->
    <view class="nutrition-summary">
      <!-- 饼状图 -->
      <view class="pie-chart-container">
        <canvas class="pie-chart" canvas-id="nutritionPieChart" style="width:160px;height:160px;"></canvas>
      </view>
      <!-- 图例 -->
      <view class="nutrition-legend">
        <view class="legend-item">
          <text class="dot carbs"></text>
          <text class="legend-label">碳水</text>
          <text class="legend-count">{{nutritionStats.carbsCount}}道</text>
        </view>
        <view class="legend-item">
          <text class="dot protein"></text>
          <text class="legend-label">蛋白质</text>
          <text class="legend-count">{{nutritionStats.proteinCount}}道</text>
        </view>
        <view class="legend-item">
          <text class="dot fat"></text>
          <text class="legend-label">脂肪</text>
          <text class="legend-count">{{nutritionStats.fatCount}}道</text>
        </view>
        <view class="legend-item">
          <text class="dot fiber"></text>
          <text class="legend-label">膳食纤维</text>
          <text class="legend-count">{{nutritionStats.fiberCount}}道</text>
        </view>
      </view>
      <view class="legend-total">
        <text class="total-label">总计</text>
        <text class="total-count">{{nutritionStats.totalCount}}道</text>
      </view>
    </view>

    <!-- 分类列表 -->
    <view class="nutrition-list">
      <view class="nutrition-group" wx:for="{{nutritionGroups}}" wx:key="type">
        <view class="group-header">
          <text class="group-emoji">{{item.emoji}}</text>
          <text class="group-name">{{item.label}}</text>
          <text class="group-count">{{item.dishes.length}}道菜</text>
        </view>
        <view class="group-dishes" wx:if="{{item.dishes.length > 0}}">
          <view class="mini-dish" wx:for="{{item.dishes}}" wx:key="id">
            <text>{{item.emoji}}</text>
            <text class="mini-name">{{item.name}}</text>
          </view>
        </view>
        <view class="group-empty" wx:else>
          <text>暂无此类菜品</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 确认按钮 -->
  <view class="bottom-bar" wx:if="{{menu.breakfast.length > 0 || menu.lunch.length > 0 || menu.dinner.length > 0}}">
    <button class="btn btn-primary" bindtap="showConfirm" disabled="{{isEvaluating}}">
      {{isEvaluating ? '评估中...' : '确认菜单并扣减食材'}}
    </button>
  </view>

  <!-- 配方弹窗 -->
  <view class="modal" wx:if="{{showRecipeModal}}" bindtap="closeRecipeModal">
    <view class="modal-content" catchtap="">
      <view class="modal-header">
        <text class="modal-title">{{currentRecipe.name}}</text>
        <text class="modal-close" bindtap="closeRecipeModal">×</text>
      </view>
      <view class="modal-body">
        <view class="section">
          <view class="section-title">食材</view>
          <view class="ingredient-list">
            <view class="ingredient-item" wx:for="{{currentRecipe.ingredients}}" wx:key="name">
              <text>{{item.name}}</text>
              <text class="amount">{{item.amount}}</text>
            </view>
          </view>
        </view>
        <view class="section">
          <view class="section-title">做法</view>
          <view class="step-list">
            <view class="step-item" wx:for="{{currentRecipe.steps}}" wx:key="index">
              <text class="step-num">{{index + 1}}</text>
              <text class="step-text">{{item}}</text>
            </view>
          </view>
        </view>
        <view class="section">
          <view class="section-title">加热方式</view>
          <view class="heat-info">
            {{currentRecipe.heatMethod === 'microwave_safe' ? '✅ 可用微波炉加热' : currentRecipe.heatMethod === 'microwave_none' ? '🔴 禁止微波炉加热' : currentRecipe.heatMethod === 'steam_only' ? '🟢 仅可用蒸锅加热' : '🟠 仅可用明火加热'}}
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 确认弹窗 -->
  <view class="modal" wx:if="{{showConfirmModal}}" bindtap="closeConfirmModal">
    <view class="modal-content" catchtap="">
      <view class="modal-header">
        <text class="modal-title">确认菜单</text>
        <text class="modal-close" bindtap="closeConfirmModal">×</text>
      </view>
      <view class="modal-body">
        <!-- 风险评估显示 -->
        <view class="risk-section" wx:if="{{isEvaluating || riskResult}}">
          <block wx:if="{{isEvaluating}}">
            <view class="risk-evaluating">
              <text>🤖 AI正在分析食材搭配风险...</text>
            </view>
          </block>
          <block wx:elif="{{riskResult && riskResult.hasRisk}}">
            <view class="risk-alert">
              <view class="risk-header">
                <text class="risk-icon">⚠️</text>
                <text class="risk-title">食材搭配风险提示</text>
              </view>
              <view class="risk-items">
                <view class="risk-item" wx:for="{{riskResult.risks}}" wx:key="*this">
                  <text class="risk-level danger">危险</text>
                  <text class="risk-text">{{item}}</text>
                </view>
              </view>
            </view>
          </block>
          <block wx:elif="{{riskResult && !riskResult.hasRisk}}">
            <view class="risk-safe">
              <text>✅ 食材搭配安全</text>
            </view>
          </block>
        </view>
        <view class="confirm-summary">
          <view class="summary-item">
            <text>🌅 早餐</text>
            <text>{{menu.breakfast.length}} 道菜</text>
          </view>
          <view class="summary-item">
            <text>☀️ 午餐</text>
            <text>{{menu.lunch.length}} 道菜</text>
          </view>
          <view class="summary-item">
            <text>🌙 晚餐</text>
            <text>{{menu.dinner.length}} 道菜</text>
          </view>
        </view>
        <view class="deduction-list">
          <view
            class="deduction-item {{item.sufficient ? 'sufficient' : 'insufficient'}}"
            wx:for="{{deductionList}}"
            wx:key="name"
          >
            <text class="deduction-icon">{{item.sufficient ? '✅' : '⚠️'}}</text>
            <text class="deduction-name">{{item.name}}</text>
            <text class="deduction-need">-{{item.need}}{{item.unit}}</text>
            <text class="deduction-stock" wx:if="{{item.sufficient}}">（剩余{{item.afterStock}}{{item.unit}}）</text>
            <text class="deduction-stock insufficient" wx:else>（需要补充{{item.needMore}}{{item.unit}}，冰箱只有{{item.stock}}{{item.unit}}）</text>
          </view>
        </view>
        <view class="confirm-tips">
          <text>确认后将自动扣减冰箱库存</text>
        </view>
      </view>
      <view class="modal-footer">
        <button class="btn btn-default" bindtap="closeConfirmModal">取消</button>
        <button class="btn btn-primary" bindtap="confirmMenu">确认</button>
      </view>
    </view>
  </view>
</view>
